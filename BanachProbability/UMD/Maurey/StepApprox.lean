module

public import BanachProbability.UMD.Maurey.FinitePaths

/-!
# Reduction of the UMD inequality to finite probability spaces

The first step of Maurey's theorem (Pisier, *Martingales in Banach spaces* (2016), §5.6; lecture
notes (2011), Lemma 8.29: approximation by martingales formed of step functions; HNVW I,
Theorem 4.2.5), adapted to predictable multipliers. Given a martingale `Y` with `Y_0 = 0` and
`Y_n ∈ L^p`, predictable multipliers `φ` with finitely many values (signs `σ_k ∈ {±1}` for the
UMD inequality) and `η > 0`:

* approximate each increment `Y_k − Y_{k−1}`, `1 ≤ k ≤ n`, in `L^p` within `δ` by an
  `ℱ_k`-measurable simple function `F_k` (`MeasureTheory.MemLp.exists_simpleFunc_eLpNorm_sub_lt`
  for the trimmed measure), `F_0 = 0`;
* let `B_k` be the finite σ-algebra generated by `F_0, …, F_k` and `φ_1, …, φ_{k+1}`, so that
  `B_k ≤ ℱ_k` and `φ` is `B`-predictable, and let
  `Y'_k = F_0 + Σ_{1 ≤ j ≤ k} (F_j − E [F_j | B_{j−1}])` be Pisier's step martingale, a
  `B`-martingale started at `0`; since
  `E [Y_j − Y_{j−1} | B_{j−1}] = 0`, `‖(Y_j − Y_{j−1}) − (Y'_j − Y'_{j−1})‖_{L^p} ≤ 2 δ`;
* everything is a function of the finitely-valued tuple `T = (F_j, φ_{j+1})_{j ≤ n}`, so the step
  martingale and the multipliers live on the finite probability space of the values of `T` with
  the law of `T` (conditional expectations commute with the law of `T`, `stp_condExp_comp`).

Both sides of the UMD inequality move by at most `η` (`exists_finite_model_gen`, and
`exists_finite_model` for signs), so a UMD bound for finite models is a UMD bound
(`isUMDBound_of_isFiniteUMDBound`).
-/

@[expose] public section

open MeasureTheory
open scoped ENNReal

namespace BanachProbability

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

section Helpers

/-- A map `g` with finitely many values whose fibers are `m`-measurable generates a σ-algebra
`σ(g) ≤ m`: every preimage under `g` is a finite union of fibers. -/
theorem stp_comap_le {Ω W : Type*} {m : MeasurableSpace Ω} {g : Ω → W}
    (hfin : (Set.range g).Finite) (hfib : ∀ w, MeasurableSet[m] {ω | g ω = w}) :
    MeasurableSpace.comap g ⊤ ≤ m := by
  rintro s ⟨t, -, rfl⟩
  have : g ⁻¹' t = ⋃ w, ⋃ (_ : w ∈ t ∧ w ∈ Set.range g), {ω | g ω = w} := by
    ext ω
    simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_ofPred_eq, exists_prop]
    exact ⟨fun h => ⟨g ω, ⟨h, ω, rfl⟩, rfl⟩, by rintro ⟨w, ⟨hw, -⟩, rfl⟩; exact hw⟩
  rw [this]
  exact Set.Finite.measurableSet_biUnion (hfin.subset fun w hw => hw.2) fun w _ => hfib w

/-- On a finite type, every function of `g` is strongly measurable for the σ-algebra `σ(g)`
generated by `g` (it is a simple function for `σ(g)`). -/
theorem stp_stronglyMeasurable_comap {Ω W E : Type*} [Finite Ω] [TopologicalSpace E]
    (g : Ω → W) (h : W → E) :
    StronglyMeasurable[MeasurableSpace.comap g ⊤] (fun ω => h (g ω)) :=
  letI : MeasurableSpace Ω := MeasurableSpace.comap g ⊤
  SimpleFunc.stronglyMeasurable ⟨fun ω => h (g ω),
    fun x => MeasurableSpace.measurableSet_comap.2
      ⟨h ⁻¹' {x}, MeasurableSpace.measurableSet_top, rfl⟩,
    Set.finite_range _⟩

/-- The conditional expectation commutes with the law of a measurable map `T : Ω → Ω'`:
`E_μ [g ∘ T | T⁻¹ m'] = E_{T_* μ} [g | m'] ∘ T` a.e., since both sides have the same integrals
over the sets `T⁻¹ t`, `t ∈ m'`. -/
theorem stp_condExp_comp {Ω Ω' E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] {mΩ : MeasurableSpace Ω} {m' mΩ' : MeasurableSpace Ω'} {μ : Measure Ω}
    [IsFiniteMeasure μ] {T : Ω → Ω'} (hT : Measurable T)
    (hm' : m' ≤ mΩ') {g : Ω' → E} (hg : Integrable g (μ.map T)) :
    (fun ω => (μ.map T)[g | m'] (T ω)) =ᵐ[μ] μ[fun ω => g (T ω) | m'.comap T] := by
  have hle : m'.comap T ≤ mΩ := (MeasurableSpace.comap_mono hm').trans hT.comap_le
  have hTm : Measurable[m'.comap T, m'] T := Measurable.of_comap_le le_rfl
  refine ae_eq_condExp_of_forall_setIntegral_eq hle (hg.comp_measurable hT)
    (fun s _ _ => (integrable_condExp.comp_measurable hT).integrableOn) ?_
    (stronglyMeasurable_condExp.comp_measurable hTm).aestronglyMeasurable
  rintro s ⟨t, ht, rfl⟩ _
  rw [← setIntegral_map (hm' t ht) integrable_condExp.aestronglyMeasurable hT.aemeasurable,
    ← setIntegral_map (hm' t ht) hg.aestronglyMeasurable hT.aemeasurable,
    setIntegral_condExp hm' hg ht]

/-- Pisier's step martingale: for an adapted integrable sequence `G`,
`M_k = Σ_{j<k} (G_{j+1} − E [G_{j+1} | ℱ_j])` is a martingale. -/
theorem stp_martingale_sum_sub_condExp {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] {mΩ : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]
    {ℱ : Filtration ℕ mΩ} {G : ℕ → Ω → E} (hG : ∀ j, StronglyMeasurable[ℱ j] (G j))
    (hGi : ∀ j, Integrable (G j) μ) :
    Martingale (fun k ω => ∑ j ∈ Finset.range k, (G (j + 1) ω - μ[G (j + 1) | ℱ j] ω)) ℱ μ := by
  refine martingale_of_condExp_sub_eq_zero_nat (fun k => ?_) (fun k => ?_) (fun i => ?_)
  · exact Finset.stronglyMeasurable_fun_sum _ fun j hj =>
      ((hG (j + 1)).mono (ℱ.mono (Finset.mem_range.1 hj))).sub
        (stronglyMeasurable_condExp.mono (ℱ.mono (Finset.mem_range.1 hj).le))
  · exact integrable_finsetSum _ fun j _ => (hGi (j + 1)).sub integrable_condExp
  · have hsucc : (fun ω => ∑ j ∈ Finset.range (i + 1), (G (j + 1) ω - μ[G (j + 1) | ℱ j] ω)) -
        (fun ω => ∑ j ∈ Finset.range i, (G (j + 1) ω - μ[G (j + 1) | ℱ j] ω)) =
        G (i + 1) - μ[G (i + 1) | ℱ i] := by
      funext ω
      simp only [Pi.sub_apply, Finset.sum_range_succ]
      abel
    have h2 : μ[μ[G (i + 1) | ℱ i] | ℱ i] = μ[G (i + 1) | ℱ i] :=
      condExp_of_stronglyMeasurable (ℱ.le i) stronglyMeasurable_condExp integrable_condExp
    refine (condExp_congr_ae (Filter.EventuallyEq.of_eq hsucc)).trans ?_
    filter_upwards [condExp_sub (hGi (i + 1)) (integrable_condExp (m := ℱ i) (μ := μ)
      (f := G (i + 1))) (ℱ i)] with ω hω
    rw [hω, Pi.sub_apply, h2, sub_self, Pi.zero_apply]

/-- **Step functions** (Pisier, Lemma 8.29, first step): the increments `Y_{j+1} − Y_j`, `j < n`,
of a martingale with `Y_n ∈ L^p`, `1 ≤ p < ∞`, are approximated in `L^p` within `δ` by
`ℱ_{j+1}`-measurable functions `F_{j+1}` with finitely many values
(`MeasureTheory.MemLp.exists_simpleFunc_eLpNorm_sub_lt` for the trimmed measure); `F_0 = 0`. -/
theorem stp_exists_stepFunctions {Ω : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}
    [IsFiniteMeasure μ] {ℱ : Filtration ℕ mΩ} {Y : ℕ → Ω → X} (hY : Martingale Y ℱ μ)
    {p : ℝ} (hp : 1 ≤ p) (n : ℕ) (hYn : eLpNorm (Y n) (ENNReal.ofReal p) μ ≠ ⊤) {δ : ℝ}
    (hδ : 0 < δ) :
    ∃ F : ℕ → Ω → X, F 0 = 0 ∧ (∀ j, StronglyMeasurable[ℱ j] (F j)) ∧
      (∀ j, (Set.range (F j)).Finite) ∧ (∀ j, MemLp (F j) (ENNReal.ofReal p) μ) ∧
      ∀ j < n, eLpNorm (fun ω => F (j + 1) ω - (Y (j + 1) ω - Y j ω)) (ENNReal.ofReal p) μ ≤
        ENNReal.ofReal δ := by
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by simpa using ENNReal.ofReal_le_ofReal hp
  have key : ∀ j, ∃ f : Ω → X, (j = 0 → f = 0) ∧ StronglyMeasurable[ℱ j] f ∧
      (Set.range f).Finite ∧ MemLp f (ENNReal.ofReal p) μ ∧ ∀ i, j = i + 1 → i < n →
        eLpNorm (fun ω => f ω - (Y (i + 1) ω - Y i ω)) (ENNReal.ofReal p) μ ≤
          ENNReal.ofReal δ := by
    intro j
    by_cases hj : ∃ i, j = i + 1 ∧ i < n
    · obtain ⟨i, rfl, hi⟩ := hj
      set d : Ω → X := fun ω => Y (i + 1) ω - Y i ω
      have hd : StronglyMeasurable[ℱ (i + 1)] d :=
        (hY.stronglyAdapted (i + 1)).sub ((hY.stronglyAdapted i).mono (ℱ.mono i.le_succ))
      have hdm : MemLp d (ENNReal.ofReal p) μ :=
        (eLpNorm_sub_le_two_mul hY hp1 hi).trans_lt (ENNReal.mul_lt_top (by simp) hYn.lt_top)
      have hdt : MemLp d (ENNReal.ofReal p) (μ.trim (ℱ.le (i + 1))) := by
        rw [memLp_iff, eLpNorm_trim _ hd]
        exact hdm
      obtain ⟨g, hg, hgm⟩ := @MemLp.exists_simpleFunc_eLpNorm_sub_lt Ω (ℱ (i + 1)) _ _ _ _ _ hdt
        ENNReal.ofReal_ne_top _ (ENNReal.ofReal_pos.2 hδ).ne'
      refine ⟨g, fun h => absurd h (Nat.succ_ne_zero i), g.stronglyMeasurable,
        @SimpleFunc.finite_range Ω X (ℱ (i + 1)) g,
        memLp_of_memLp_trim _ hgm, ?_⟩
      rintro i' hi' -
      obtain rfl : i = i' := by omega
      have : (fun ω => g ω - (Y (i + 1) ω - Y i ω)) = ⇑g - d := rfl
      rw [this, eLpNorm_sub_comm, ← eLpNorm_trim (ℱ.le (i + 1)) (hd.sub g.stronglyMeasurable)]
      exact hg.le
    · refine ⟨0, fun _ => rfl, stronglyMeasurable_zero, Set.finite_range_const, MemLp.zero,
        fun i hi hin => absurd ⟨i, hi, hin⟩ hj⟩
  choose F hF0 hFm hFfin hFmem hF using key
  exact ⟨F, hF0 0 rfl, hFm, hFfin, hFmem, fun j hj => hF (j + 1) j rfl hj⟩

/-- Multipliers with finitely many values are bounded on finitely many times. -/
theorem stp_exists_bound {Ω 𝕜 : Type*} [NormedAddCommGroup 𝕜] {φ : ℕ → Ω → 𝕜}
    (hφfin : ∀ k, (Set.range (φ (k + 1))).Finite) (n : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ k < n, ∀ ω, ‖φ (k + 1) ω‖ ≤ C := by
  have hfin : (⋃ k ∈ Finset.range n, norm '' Set.range (φ (k + 1))).Finite :=
    (Finset.range n).finite_toSet.biUnion fun k _ => (hφfin k).image _
  obtain ⟨C₀, hC₀⟩ := hfin.bddAbove
  refine ⟨max C₀ 1, le_max_right _ _, fun k hk ω => (hC₀ ?_).trans (le_max_left _ _)⟩
  exact Set.mem_biUnion (Finset.mem_coe.2 (Finset.mem_range.2 hk)) ⟨φ (k + 1) ω, ⟨ω, rfl⟩, rfl⟩

end Helpers

/-- **Finite models** of a martingale transform by general multipliers (Pisier, Lemma 8.29,
adapted to predictable multipliers): for a martingale `Y` started at `0` with `Y_n ∈ L^p`,
predictable multipliers `φ` with values in `A` and finitely many values at each time, and
`η > 0`, there are a martingale `Y'` started at `0` and predictable multipliers `φ'` with values
in `A` on a finite probability space with `‖Y'_n‖_{L^p} ≤ ‖Y_n‖_{L^p} + η` and
`‖(φ • Y)_n‖_{L^p} ≤ ‖(φ' • Y')_n‖_{L^p} + η`.

The step functions `F_j`, `‖F_j − (Y_j − Y_{j−1})‖_{L^p} ≤ δ` (`stp_exists_stepFunctions`), and
the multipliers form the finitely-valued tuple `T = (F_j, φ_{j+1})_{j ≤ n}`. The finite space is
the set of values of `T` (as a `Fin K`) with the law of `T`, the σ-algebra at time `k` being
generated by the coordinates `j ≤ k`; on it `Y'_k = Σ_{j<k} (F'_{j+1} − E' [F'_{j+1} | ℱ'_j])`,
whose pull-back along `T` is a.e. Pisier's step martingale `Σ_{j<k} (F_{j+1} − E [F_{j+1} | B_j])`
(`k ≤ n`), with `B_j = σ(F_0, …, F_j, φ_1, …, φ_{j+1}) ≤ ℱ_j` (`stp_condExp_comp`). As
`E [Y_{j+1} − Y_j | B_j] = 0`, the increments of `Y` and of the step martingale differ by at
most `2 δ` in `L^p`, and `2 n C δ ≤ η` for a bound `C ≥ 1` of the multipliers. -/
theorem exists_finite_model_gen {𝕜 : Type} [RCLike 𝕜] [NormedSpace 𝕜 X] [IsScalarTower ℝ 𝕜 X]
    {Ω : Type} {mΩ : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
    {ℱ : Filtration ℕ mΩ} {Y : ℕ → Ω → X} {φ : ℕ → Ω → 𝕜} (hY : Martingale Y ℱ μ)
    (hY0 : ∀ ω, Y 0 ω = 0) {A : Set 𝕜} (hφA : ∀ n ω, φ n ω ∈ A)
    (hφfin : ∀ k, (Set.range (φ (k + 1))).Finite)
    (hφm : ∀ k, StronglyMeasurable[ℱ k] (φ (k + 1))) {p : ℝ} (hp : 1 ≤ p) (n : ℕ)
    (hYn : eLpNorm (Y n) (ENNReal.ofReal p) μ ≠ ⊤) {η : ℝ} (hη : 0 < η) :
    ∃ (Ω' : Type) (_ : Fintype Ω') (m' : MeasurableSpace Ω') (_ : DiscreteMeasurableSpace Ω')
      (μ' : Measure Ω') (_ : IsProbabilityMeasure μ') (ℱ' : Filtration ℕ m') (Y' : ℕ → Ω' → X)
      (φ' : ℕ → Ω' → 𝕜),
      Martingale Y' ℱ' μ' ∧ (∀ ω, Y' 0 ω = 0) ∧ (∀ n ω, φ' n ω ∈ A) ∧
      (∀ k, StronglyMeasurable[ℱ' k] (φ' (k + 1))) ∧
      eLpNorm (fun ω => ‖Y' n ω‖) (ENNReal.ofReal p) μ' ≤
        eLpNorm (fun ω => ‖Y n ω‖) (ENNReal.ofReal p) μ + ENNReal.ofReal η ∧
      eLpNorm (fun ω => ‖martingaleTransform φ Y n ω‖) (ENNReal.ofReal p) μ ≤
        eLpNorm (fun ω => ‖martingaleTransform φ' Y' n ω‖) (ENNReal.ofReal p) μ' +
          ENNReal.ofReal η := by
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by simpa using ENNReal.ofReal_le_ofReal hp
  -- the bound `C` on the multipliers and the step size `δ`, with `2 n C δ ≤ η`
  obtain ⟨C, hC1, hC⟩ := stp_exists_bound hφfin n
  have hC0 : 0 < C := by linarith
  obtain ⟨δ, hδ_def⟩ : ∃ δ : ℝ, δ = η / (2 * C * (n + 1)) := ⟨_, rfl⟩
  have hδ : 0 < δ := by rw [hδ_def]; positivity
  have hδη : (n : ℝ) * (C * (2 * δ)) ≤ η := by
    have hCne : C ≠ 0 := hC0.ne'
    have hn1 : (n : ℝ) + 1 ≠ 0 := by positivity
    have h1 : C * (2 * δ) = η / (n + 1) := by rw [hδ_def]; field_simp
    rw [h1, mul_div_assoc', div_le_iff₀ (by positivity)]
    nlinarith
  -- step 1: the step functions `F_j`, `‖F_{j+1} − (Y_{j+1} − Y_j)‖_p ≤ δ`
  obtain ⟨F, -, hFm, hFfin, hFmem, hF⟩ := stp_exists_stepFunctions hY hp n hYn hδ
  -- step 2: the tuple `T = (F_j, φ_{j+1})_{j ≤ n}` and its truncations
  -- `P_k T = (F_j, φ_{j+1})_{j ≤ k}`, which generate the finite σ-algebras `B_k ≤ ℱ_k`
  obtain ⟨T, hT⟩ : ∃ T : Ω → Fin (n + 1) → X × 𝕜, ∀ ω j, T ω j = (F j ω, φ (j + 1) ω) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : ℕ → (Fin (n + 1) → X × 𝕜) → Fin (n + 1) → X × 𝕜,
      ∀ k w j, P k w j = if (j : ℕ) ≤ k then w j else 0 := ⟨_, fun _ _ _ => rfl⟩
  have hPP : ∀ k l, k ≤ l → ∀ w, P k (P l w) = P k w := by
    intro k l hkl w
    funext j
    simp only [hP]
    split_ifs with h1 h2 <;> first | rfl | (exfalso; omega)
  have hPn : ∀ w, P n w = w := fun w => funext fun j => by rw [hP, ite_eq_left (by omega)]
  have hTfin : (Set.range T).Finite := by
    refine (Set.Finite.pi fun j : Fin (n + 1) => (hFfin j).prod (hφfin j)).subset ?_
    rintro _ ⟨ω, rfl⟩ j -
    rw [hT]
    exact Set.mk_mem_prod (Set.mem_range_self ω) (Set.mem_range_self ω)
  have hPfin : ∀ k, (Set.range fun ω => P k (T ω)).Finite := fun k =>
    (hTfin.image (P k)).subset (by rintro _ ⟨ω, rfl⟩; exact ⟨T ω, ⟨ω, rfl⟩, rfl⟩)
  have hfib : ∀ k w, MeasurableSet[ℱ k] {ω | P k (T ω) = w} := by
    intro k w
    have hcoord : ∀ j : Fin (n + 1), StronglyMeasurable[ℱ k] fun ω => P k (T ω) j := by
      intro j
      by_cases h : (j : ℕ) ≤ k
      · simp only [hP, hT, ite_eq_left h]
        exact ((hFm j).mono (ℱ.mono h)).prodMk ((hφm j).mono (ℱ.mono h))
      · simp only [hP, ite_eq_right h]
        exact stronglyMeasurable_const
    have : {ω | P k (T ω) = w} = ⋂ j, {ω | P k (T ω) j = w j} := by
      ext ω
      simp [funext_iff]
    rw [this]
    exact MeasurableSet.iInter fun j => (hcoord j).measurableSet_eq_fun stronglyMeasurable_const
  -- step 3: the finite space `Fin K` of the values of `T`
  obtain ⟨K, ι, T', hιT, hιR, hι⟩ : ∃ (K : ℕ) (ι : Fin K → Fin (n + 1) → X × 𝕜) (T' : Ω → Fin K),
      (∀ ω, ι (T' ω) = T ω) ∧ (∀ i, ∃ ω, T ω = ι i) ∧ Function.Injective ι := by
    have := hTfin.to_subtype
    let e := Finite.equivFin (Set.range T)
    exact ⟨_, fun i => (e.symm i : Fin (n + 1) → X × 𝕜), fun ω => e ⟨T ω, ω, rfl⟩,
      fun ω => congrArg Subtype.val (e.symm_apply_apply _), fun i => (e.symm i).2,
      fun i i' h => e.symm.injective (Subtype.ext h)⟩
  have hT'm : Measurable T' := by
    refine measurable_to_countable' fun i => ?_
    have : T' ⁻¹' {i} = {ω | P n (T ω) = ι i} := by
      ext ω
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_ofPred_eq, hPn]
      exact ⟨fun h => by rw [← hιT ω, h], fun h => hι ((hιT ω).trans h)⟩
    rw [this]
    exact ℱ.le n _ (hfib n (ι i))
  obtain ⟨ℱ', hℱ'⟩ : ∃ ℱ' : Filtration ℕ (inferInstance : MeasurableSpace (Fin K)),
      ∀ k, ℱ' k = MeasurableSpace.comap (fun i => P k (ι i)) ⊤ := by
    refine ⟨⟨fun k => MeasurableSpace.comap (fun i => P k (ι i)) ⊤, fun k l hkl => ?_,
      fun k s _ => MeasurableSet.of_discrete⟩, fun k => rfl⟩
    rintro s ⟨t, -, rfl⟩
    exact ⟨P k ⁻¹' t, MeasurableSpace.measurableSet_top, by ext i; simp [hPP k l hkl]⟩
  obtain ⟨G, hG⟩ : ∃ G : ℕ → Fin K → X, ∀ j i, G j i = (ι i ⟨min j n, by omega⟩).1 :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨φ', hφ'⟩ : ∃ φ' : ℕ → Fin K → 𝕜,
      ∀ j i, φ' j i = (ι i ⟨min (j - 1) n, by omega⟩).2 := ⟨_, fun _ _ => rfl⟩
  have hGm : ∀ j, StronglyMeasurable[ℱ' j] (G j) := by
    intro j
    have : G j = fun i => (P j (ι i) ⟨min j n, by omega⟩).1 := by
      funext i
      rw [hG, hP, ite_eq_left (min_le_left j n)]
    rw [this, hℱ']
    exact stp_stronglyMeasurable_comap (fun i => P j (ι i)) fun w => (w ⟨min j n, by omega⟩).1
  have hφ'm : ∀ k, StronglyMeasurable[ℱ' k] (φ' (k + 1)) := by
    intro k
    have : φ' (k + 1) = fun i => (P k (ι i) ⟨min k n, by omega⟩).2 := by
      funext i
      simp [hφ', hP]
    rw [this, hℱ']
    exact stp_stronglyMeasurable_comap (fun i => P k (ι i)) fun w => (w ⟨min k n, by omega⟩).2
  -- Pisier's step martingale, computed on the finite space
  obtain ⟨Y', hY'⟩ : ∃ Y' : ℕ → Fin K → X, Y' = fun k i =>
      ∑ j ∈ Finset.range k, (G (j + 1) i - (μ.map T')[G (j + 1) | ℱ' j] i) := ⟨_, rfl⟩
  have hY'm : Martingale Y' ℱ' (μ.map T') := by
    rw [hY']
    exact stp_martingale_sum_sub_condExp hGm fun _ => Integrable.of_finite
  -- step 4: the pull-back to `Ω`
  have hGT : ∀ j ω, G j (T' ω) = F (min j n) ω := by
    intro j ω
    simp [hG, hιT, hT]
  have hφT : ∀ k ω, φ' (k + 1) (T' ω) = φ (min k n + 1) ω := by
    intro k ω
    simp [hφ', hιT, hT]
  have hB : ∀ j, MeasurableSpace.comap T' (ℱ' j) ≤ ℱ j := by
    intro j
    rw [hℱ', MeasurableSpace.comap_comp]
    have : ((fun i => P j (ι i)) ∘ T') = fun ω => P j (T ω) := by
      funext ω
      simp [hιT]
    rw [this]
    exact stp_comap_le (hPfin j) (hfib j)
  have hcT : ∀ j < n, (fun ω => (μ.map T')[G (j + 1) | ℱ' j] (T' ω)) =ᵐ[μ]
      μ[F (j + 1) | MeasurableSpace.comap T' (ℱ' j)] := by
    intro j hj
    have h1 : (fun ω => G (j + 1) (T' ω)) = F (j + 1) := by
      funext ω
      rw [hGT, min_eq_left (show j + 1 ≤ n by omega)]
    have := stp_condExp_comp (μ := μ) hT'm (ℱ'.le j) (Integrable.of_finite (f := G (j + 1)))
    rwa [h1] at this
  have hall : ∀ᵐ ω ∂μ, ∀ j < n, (μ.map T')[G (j + 1) | ℱ' j] (T' ω) =
      μ[F (j + 1) | MeasurableSpace.comap T' (ℱ' j)] ω := by
    rw [ae_all_iff]
    intro j
    by_cases hj : j < n
    · filter_upwards [hcT j hj] with ω hω _ using hω
    · exact Filter.Eventually.of_forall fun ω h => absurd h hj
  have hdY0 : ∀ j, μ[fun ω => Y (j + 1) ω - Y j ω | MeasurableSpace.comap T' (ℱ' j)] =ᵐ[μ] 0 := by
    intro j
    have h1 : μ[fun ω => Y (j + 1) ω - Y j ω | ℱ j] =ᵐ[μ] 0 := by
      filter_upwards [condExp_sub (hY.integrable (j + 1)) (hY.integrable j) (ℱ j),
        hY.condExp_ae_eq j.le_succ, hY.condExp_ae_eq (le_refl j)] with ω h1 h2 h3
      change μ[Y (j + 1) - Y j | ℱ j] ω = 0
      rw [h1, Pi.sub_apply, h2, h3, sub_self]
    refine (condExp_condExp_of_le (hB j) (ℱ.le j)).symm.trans ?_
    refine (condExp_congr_ae h1).trans ?_
    rw [condExp_zero]
  -- the errors `D_j = (F_{j+1} − E [F_{j+1} | B_j]) − (Y_{j+1} − Y_j)`, `‖D_j‖_p ≤ 2 δ`
  obtain ⟨D, hD_def⟩ : ∃ D : ℕ → Ω → X, ∀ j ω, D j ω = F (j + 1) ω -
      μ[F (j + 1) | MeasurableSpace.comap T' (ℱ' j)] ω - (Y (j + 1) ω - Y j ω) :=
    ⟨_, fun _ _ => rfl⟩
  have hD : ∀ j < n, eLpNorm (D j) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal (2 * δ) := by
    intro j hj
    have hFi : Integrable (F (j + 1)) μ := (hFmem (j + 1)).integrable hp1
    have hdi : Integrable (fun ω => Y (j + 1) ω - Y j ω) μ :=
      (hY.integrable _).sub (hY.integrable _)
    have hsub : μ[fun ω => F (j + 1) ω - (Y (j + 1) ω - Y j ω) | MeasurableSpace.comap T' (ℱ' j)]
        =ᵐ[μ] μ[F (j + 1) | MeasurableSpace.comap T' (ℱ' j)] -
          μ[fun ω => Y (j + 1) ω - Y j ω | MeasurableSpace.comap T' (ℱ' j)] :=
      condExp_sub hFi hdi _
    have hD_ae : D j =ᵐ[μ] (fun ω => F (j + 1) ω - (Y (j + 1) ω - Y j ω)) -
        μ[fun ω => F (j + 1) ω - (Y (j + 1) ω - Y j ω) | MeasurableSpace.comap T' (ℱ' j)] := by
      filter_upwards [hsub, hdY0 j] with ω h1 h2
      rw [Pi.sub_apply, h1, Pi.sub_apply, h2, Pi.zero_apply, sub_zero, hD_def]
      abel
    rw [eLpNorm_congr_ae hD_ae]
    calc _ ≤ ENNReal.ofReal δ + ENNReal.ofReal δ :=
          (eLpNorm_sub_le hp1).trans (add_le_add (hF j hj)
            ((eLpNorm_condExp_le_eLpNorm _ hp1).trans (hF j hj)))
      _ = ENNReal.ofReal (2 * δ) := by rw [two_mul, ENNReal.ofReal_add hδ.le hδ.le]
  have hDm : ∀ j < n, AEStronglyMeasurable (D j) μ := fun j hj =>
    MemLp.aestronglyMeasurable ((hD j hj).trans_lt ENNReal.ofReal_lt_top)
  -- the pull-backs of `Y'_n` and of `(φ' • Y')_n`
  have hY'T : (fun ω => Y' n (T' ω)) =ᵐ[μ] fun ω => Y n ω + ∑ j ∈ Finset.range n, D j ω := by
    filter_upwards [hall] with ω hω
    have hYn' : Y n ω = ∑ j ∈ Finset.range n, (Y (j + 1) ω - Y j ω) :=
      ((Finset.sum_range_sub (fun j => Y j ω) n).trans (by simp [hY0])).symm
    simp only [hY']
    rw [hYn', ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j hj => ?_
    have hj' := Finset.mem_range.1 hj
    rw [hω j hj', hGT, min_eq_left (show j + 1 ≤ n by omega), hD_def]
    abel
  have hMT : martingaleTransform φ Y n =ᵐ[μ] fun ω =>
      martingaleTransform φ' Y' n (T' ω) - ∑ j ∈ Finset.range n, φ (j + 1) ω • D j ω := by
    filter_upwards [hall] with ω hω
    simp only [martingaleTransform]
    rw [eq_sub_iff_add_eq, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j hj => ?_
    have hj' := Finset.mem_range.1 hj
    have hinc : Y' (j + 1) (T' ω) - Y' j (T' ω) =
        G (j + 1) (T' ω) - (μ.map T')[G (j + 1) | ℱ' j] (T' ω) := by
      simp only [hY', Finset.sum_range_succ, add_sub_cancel_left]
    rw [hinc, hω j hj', hGT, min_eq_left (show j + 1 ≤ n by omega), hφT,
      min_eq_left hj'.le, hD_def, ← smul_add]
    congr 1
    abel
  -- the `L^p` estimates
  have hsumδ : ∀ b : ℕ → ℝ≥0∞, (∀ j < n, b j ≤ ENNReal.ofReal (C * (2 * δ))) →
      ∑ j ∈ Finset.range n, b j ≤ ENNReal.ofReal η := by
    intro b hb
    calc ∑ j ∈ Finset.range n, b j ≤ ∑ j ∈ Finset.range n, ENNReal.ofReal (C * (2 * δ)) :=
          Finset.sum_le_sum fun j hj => hb j (Finset.mem_range.1 hj)
      _ = ENNReal.ofReal (n * (C * (2 * δ))) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul,
            ENNReal.ofReal_mul (Nat.cast_nonneg n), ENNReal.ofReal_natCast]
      _ ≤ ENNReal.ofReal η := ENNReal.ofReal_le_ofReal hδη
  have hDC : ∀ j < n, eLpNorm (D j) (ENNReal.ofReal p) μ ≤ ENNReal.ofReal (C * (2 * δ)) :=
    fun j hj => (hD j hj).trans
      (ENNReal.ofReal_le_ofReal (le_mul_of_one_le_left (by positivity) hC1))
  have hφD : ∀ j < n, eLpNorm (fun ω => φ (j + 1) ω • D j ω) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (C * (2 * δ)) := by
    intro j hj
    have hm : AEStronglyMeasurable (fun ω => φ (j + 1) ω • D j ω) μ :=
      ((hφm j).mono (ℱ.le j)).aestronglyMeasurable.smul (hDm j hj)
    calc _ ≤ ENNReal.ofReal C * eLpNorm (D j) (ENNReal.ofReal p) μ :=
          eLpNorm_le_mul_eLpNorm_of_ae_le_mul hm (ae_of_all _ fun ω => by
            rw [norm_smul]
            exact mul_le_mul_of_nonneg_right (hC j hj ω) (norm_nonneg _)) _
      _ ≤ ENNReal.ofReal C * ENNReal.ofReal (2 * δ) := by gcongr; exact hD j hj
      _ = _ := (ENNReal.ofReal_mul hC0.le).symm
  have hYnm : AEStronglyMeasurable (Y n) μ :=
    ((hY.stronglyAdapted n).mono (ℱ.le n)).aestronglyMeasurable
  have hMTm : AEStronglyMeasurable (martingaleTransform φ Y n) μ :=
    (Finset.stronglyMeasurable_fun_sum _ fun k _ => ((hφm k).mono (ℱ.le k)).smul
      (((hY.stronglyAdapted (k + 1)).mono (ℱ.le _)).sub
        ((hY.stronglyAdapted k).mono (ℱ.le _)))).aestronglyMeasurable
  refine ⟨Fin K, inferInstance, inferInstance, inferInstance, μ.map T', inferInstance, ℱ', Y',
    φ', hY'm, fun i => by simp [hY'], fun k i => ?_, hφ'm, ?_, ?_⟩
  · obtain ⟨ω, hω⟩ := hιR i
    rw [hφ', ← hω, hT]
    exact hφA _ ω
  · rw [eLpNorm_norm _ Integrable.of_finite.aestronglyMeasurable,
      eLpNorm_map_measure Integrable.of_finite.aestronglyMeasurable hT'm.aemeasurable,
      eLpNorm_norm _ hYnm]
    calc eLpNorm (Y' n ∘ T') (ENNReal.ofReal p) μ =
          eLpNorm (fun ω => Y n ω + ∑ j ∈ Finset.range n, D j ω) (ENNReal.ofReal p) μ :=
          eLpNorm_congr_ae hY'T
      _ ≤ eLpNorm (Y n) (ENNReal.ofReal p) μ +
          eLpNorm (∑ j ∈ Finset.range n, D j) (ENNReal.ofReal p) μ := by
          have : (fun ω => Y n ω + ∑ j ∈ Finset.range n, D j ω) =
              Y n + ∑ j ∈ Finset.range n, D j := by
            funext ω
            simp [Finset.sum_apply]
          rw [this]
          exact eLpNorm_add_le hp1
      _ ≤ eLpNorm (Y n) (ENNReal.ofReal p) μ + ENNReal.ofReal η := by
          gcongr
          exact (eLpNorm_sum_le hp1).trans (hsumδ _ hDC)
  · rw [eLpNorm_norm _ hMTm, eLpNorm_norm _ Integrable.of_finite.aestronglyMeasurable,
      eLpNorm_map_measure Integrable.of_finite.aestronglyMeasurable hT'm.aemeasurable,
      eLpNorm_congr_ae hMT]
    have : (fun ω => martingaleTransform φ' Y' n (T' ω) -
        ∑ j ∈ Finset.range n, φ (j + 1) ω • D j ω) =
        martingaleTransform φ' Y' n ∘ T' - ∑ j ∈ Finset.range n, fun ω => φ (j + 1) ω • D j ω := by
      funext ω
      simp [Finset.sum_apply]
    rw [this]
    exact (eLpNorm_sub_le hp1).trans (add_le_add le_rfl
      ((eLpNorm_sum_le hp1).trans (hsumδ _ hφD)))

/-- **Finite models** of a martingale transform: for a martingale `Y` started at `0` with
`Y_n ∈ L^p`, predictable signs `σ` and `η > 0`, there is a martingale `Y'` started at `0` with
predictable signs `σ'` on a finite probability space with
`‖Y'_n‖_{L^p} ≤ ‖Y_n‖_{L^p} + η` and `‖(σ • Y)_n‖_{L^p} ≤ ‖(σ' • Y')_n‖_{L^p} + η`. This is the
case `𝕜 = ℝ`, `A = {1, −1}` of `exists_finite_model_gen`. -/
theorem exists_finite_model {Ω : Type} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}
    [IsProbabilityMeasure μ] {ℱ : Filtration ℕ mΩ} {Y : ℕ → Ω → X} {σ : ℕ → Ω → ℝ}
    (hY : Martingale Y ℱ μ) (hY0 : ∀ ω, Y 0 ω = 0) (hσ : ∀ n ω, σ n ω = 1 ∨ σ n ω = -1)
    (hσm : ∀ k, StronglyMeasurable[ℱ k] (σ (k + 1))) {p : ℝ} (hp : 1 ≤ p) (n : ℕ)
    (hYn : eLpNorm (Y n) (ENNReal.ofReal p) μ ≠ ⊤) {η : ℝ} (hη : 0 < η) :
    ∃ (Ω' : Type) (_ : Fintype Ω') (m' : MeasurableSpace Ω') (_ : DiscreteMeasurableSpace Ω')
      (μ' : Measure Ω') (_ : IsProbabilityMeasure μ') (ℱ' : Filtration ℕ m') (Y' : ℕ → Ω' → X)
      (σ' : ℕ → Ω' → ℝ),
      Martingale Y' ℱ' μ' ∧ (∀ ω, Y' 0 ω = 0) ∧ (∀ n ω, σ' n ω = 1 ∨ σ' n ω = -1) ∧
      (∀ k, StronglyMeasurable[ℱ' k] (σ' (k + 1))) ∧
      eLpNorm (fun ω => ‖Y' n ω‖) (ENNReal.ofReal p) μ' ≤
        eLpNorm (fun ω => ‖Y n ω‖) (ENNReal.ofReal p) μ + ENNReal.ofReal η ∧
      eLpNorm (fun ω => ‖martingaleTransform σ Y n ω‖) (ENNReal.ofReal p) μ ≤
        eLpNorm (fun ω => ‖martingaleTransform σ' Y' n ω‖) (ENNReal.ofReal p) μ' +
          ENNReal.ofReal η := by
  have hσA : ∀ n ω, σ n ω ∈ ({1, -1} : Set ℝ) := fun n ω => hσ n ω
  obtain ⟨Ω', hΩ', m', hd, μ', hμ', ℱ', Y', σ', h1, h2, h3, h4, h5, h6⟩ :=
    exists_finite_model_gen (𝕜 := ℝ) hY hY0 hσA
      (fun k => (Set.toFinite ({1, -1} : Set ℝ)).subset (Set.range_subset_iff.2 (hσA (k + 1))))
      hσm hp n hYn hη
  exact ⟨Ω', hΩ', m', hd, μ', hμ', ℱ', Y', σ', h1, h2, h3, h4, h5, h6⟩

/-- The cube instance for finite models: the martingale `Y_1 = ε_0 x` on the one-sign cube,
transformed by `σ ≡ 1`, shows that a UMD bound for finite models of a nonzero space is at
least `1`. -/
theorem stp_one_le_of_isFiniteUMDBound [Nontrivial X] {p : ℝ} (hp : 0 < p) {β : ℝ≥0∞}
    (h : IsFiniteUMDBound X p β) : 1 ≤ β := by
  obtain ⟨x, hx⟩ := exists_ne (0 : X)
  have key := h (Fin 1 → Bool) inferInstance (ProbabilityTheory.uniformOn Set.univ)
    (SignCube.filtration 1) (fun k => SignCube.paleyWalsh (fun _ _ => x) k) (fun _ _ => 1)
    (SignCube.martingale_paleyWalsh _ (umdd_isPredictable_const x))
    (fun ω => SignCube.paleyWalsh_zero _ ω) (fun _ _ => Or.inl rfl)
    (fun _ => stronglyMeasurable_const) 1
  simp only [martingaleTransform, Finset.sum_range_one, one_smul, zero_add,
    SignCube.paleyWalsh_zero, sub_zero] at key
  rw [umdd_eLpNorm_norm_uniformOn _ hp,
    umdd_lpNorm_of_norm_eq (norm_nonneg x) (umdd_norm_paleyWalsh_const x) hp] at key
  have h0 : ENNReal.ofReal ‖x‖ ≠ 0 := by simpa using hx
  exact (ENNReal.mul_le_mul_iff_left h0 ENNReal.ofReal_ne_top).mp (by simpa using key)

/-- A UMD bound for martingales on finite probability spaces is a UMD bound. If `‖Y_n‖_{L^p} < ∞`,
the finite models (`exists_finite_model`) give `‖(σ • Y)_n‖_{L^p} ≤ β (‖Y_n‖_{L^p} + η) + η`
for every `η > 0`; if `‖Y_n‖_{L^p} = ∞`, the right side is infinite, as `β ≠ 0` on a nonzero
space (`stp_one_le_of_isFiniteUMDBound`). -/
theorem isUMDBound_of_isFiniteUMDBound {p : ℝ} (hp : 1 ≤ p) {β : ℝ≥0∞}
    (h : IsFiniteUMDBound X p β) : IsUMDBound X p β := by
  intro Ω mΩ μ _ ℱ Y σ hY hY0 hσ hσm n
  have hp0 : ENNReal.ofReal p ≠ 0 := by simp; linarith
  change eLpNorm (fun ω => ‖martingaleTransform σ Y n ω‖) (ENNReal.ofReal p) μ ≤ _
  have hYnm : AEStronglyMeasurable (Y n) μ :=
    ((hY.stronglyAdapted n).mono (ℱ.le n)).aestronglyMeasurable
  have hMTm : AEStronglyMeasurable (martingaleTransform σ Y n) μ :=
    (Finset.stronglyMeasurable_fun_sum _ fun k _ => ((hσm k).mono (ℱ.le k)).smul
      (((hY.stronglyAdapted (k + 1)).mono (ℱ.le _)).sub
        ((hY.stronglyAdapted k).mono (ℱ.le _)))).aestronglyMeasurable
  rw [eLpNorm_norm _ hYnm]
  by_cases hYn : eLpNorm (Y n) (ENNReal.ofReal p) μ = ⊤
  · -- infinite right side: `β = 0` is excluded by the cube instance on a nonzero space
    by_cases hβ : β = 0
    · rcases subsingleton_or_nontrivial X with hX | hX
      · simp [norm_of_subsingleton]
      · exact absurd hβ (zero_lt_one.trans_le
          (stp_one_le_of_isFiniteUMDBound (by linarith) h)).ne'
    · rw [hYn, ENNReal.mul_top hβ]
      exact le_top
  -- finite right side: the finite models give `LHS ≤ β (‖Y_n‖_p + η) + η` for every `η > 0`
  have key : ∀ η : ℝ, 0 < η → eLpNorm (fun ω => ‖martingaleTransform σ Y n ω‖)
      (ENNReal.ofReal p) μ ≤
        β * (eLpNorm (Y n) (ENNReal.ofReal p) μ + ENNReal.ofReal η) + ENNReal.ofReal η := by
    intro η hη
    obtain ⟨Ω', _, m', _, μ', _, ℱ', Y', σ', hY', hY'0, hσ', hσ'm, h1, h2⟩ :=
      exists_finite_model hY hY0 hσ hσm hp n hYn hη
    rw [eLpNorm_norm _ hYnm] at h1
    calc _ ≤ _ := h2
      _ ≤ β * eLpNorm (fun ω => ‖Y' n ω‖) (ENNReal.ofReal p) μ' + ENNReal.ofReal η := by
          gcongr
          exact h Ω' m' μ' ℱ' Y' σ' hY' hY'0 hσ' hσ'm n
      _ ≤ _ := by gcongr
  by_cases hβt : β = ⊤
  · by_cases hY0' : eLpNorm (Y n) (ENNReal.ofReal p) μ = 0
    · rw [eLpNorm_norm _ hMTm]
      have := umdd_eLpNorm_transform_eq_zero hY hp0 hY0' σ
      exact (le_of_eq this).trans zero_le
    · rw [hβt, ENNReal.top_mul hY0']
      exact le_top
  lift β to NNReal using hβt
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  have hη : 0 < (ε : ℝ) / (β + 1) := by positivity
  refine (key _ hη).trans (le_of_eq ?_)
  rw [mul_add, add_assoc]
  congr 1
  rw [← ENNReal.ofReal_coe_nnreal (p := β), ← ENNReal.ofReal_mul (by positivity),
    ← ENNReal.ofReal_add (by positivity) (by positivity), ← ENNReal.ofReal_coe_nnreal]
  congr 1
  field_simp

end BanachProbability
