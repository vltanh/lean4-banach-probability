module

public import BanachProbability.UMD.Defs

/-!
# Martingales on finite probability spaces

On a finite probability space every σ-algebra is generated by its atoms, which are measurable
(`measurableSet_atom`), and the conditional expectation given it is the average over atoms
(`condExp_eq_atom_average`). A martingale and predictable signs on such a space are a finite
*model* of a martingale transform. This file defines

* `atom m ω`: the points that no `m`-measurable set separates from `ω`;
* `IsFiniteUMDBound X p β`: the UMD inequality restricted to finite probability spaces.
-/

@[expose] public section

open MeasureTheory
open scoped ENNReal

namespace BanachProbability

/-- The atom of `ω` in the σ-algebra `m`: the points that no `m`-measurable set separates from
`ω`. -/
def atom {Ω : Type*} (m : MeasurableSpace Ω) (ω : Ω) : Set Ω :=
  {ω' | ∀ s, MeasurableSet[m] s → (ω ∈ s ↔ ω' ∈ s)}

theorem mem_atom_self {Ω : Type*} (m : MeasurableSpace Ω) (ω : Ω) : ω ∈ atom m ω :=
  fun _ _ => Iff.rfl

/-- On a finite space, the atoms of a σ-algebra are measurable. -/
theorem measurableSet_atom {Ω : Type*} [Finite Ω] (m : MeasurableSpace Ω) (ω : Ω) :
    MeasurableSet[m] (atom m ω) := by
  classical
  -- the atom is the intersection of the measurable sets containing `ω` and of the complements of
  -- those not containing it, finitely many sets
  have h : atom m ω = ⋂ s ∈ {s : Set Ω | MeasurableSet[m] s}, (if ω ∈ s then s else sᶜ) := by
    ext ω'
    simp only [Set.mem_iInter, Set.mem_ofPred_eq]
    refine ⟨fun h s hs => ?_, fun h s hs => ?_⟩
    · by_cases hω : ω ∈ s
      · simpa [hω] using (h s hs).1 hω
      · simpa [hω] using fun h' => hω ((h s hs).2 h')
    · by_cases hω : ω ∈ s
      · have h' := h s hs
        simp only [hω, ↓reduceIte] at h'
        exact ⟨fun _ => h', fun _ => hω⟩
      · have h' := h s hs
        simp only [hω, ↓reduceIte, Set.mem_compl_iff] at h'
        exact ⟨fun h'' => absurd h'' hω, fun h'' => absurd h'' h'⟩
  rw [h]
  refine Set.Finite.measurableSet_biInter (Set.toFinite _) fun s hs => ?_
  split_ifs
  · exact hs
  · exact hs.compl

/-- Membership in an atom is symmetric. -/
theorem fpa_mem_atom_comm {Ω : Type*} {m : MeasurableSpace Ω} {x y : Ω} :
    y ∈ atom m x ↔ x ∈ atom m y :=
  ⟨fun h s hs => (h s hs).symm, fun h s hs => (h s hs).symm⟩

/-- The atoms partition the space: a point of the atom of `x` has the same atom as `x`. -/
theorem fpa_atom_eq_of_mem {Ω : Type*} {m : MeasurableSpace Ω} {x y : Ω} (h : y ∈ atom m x) :
    atom m y = atom m x := by
  ext z
  exact ⟨fun hz s hs => (h s hs).trans (hz s hs), fun hz s hs => (h s hs).symm.trans (hz s hs)⟩

/-- The atoms of a finer σ-algebra are smaller. -/
theorem fpa_mem_atom_of_le {Ω : Type*} {m₁ m₂ : MeasurableSpace Ω} (h : m₁ ≤ m₂) {x y : Ω}
    (hy : y ∈ atom m₂ x) : y ∈ atom m₁ x :=
  fun s hs => hy s (h s hs)

/-- The trivial σ-algebra has the whole space as its only atom. -/
theorem fpa_atom_bot {Ω : Type*} (x : Ω) : atom ⊥ x = Set.univ := by
  ext y
  simp only [Set.mem_univ, iff_true]
  intro s hs
  rcases MeasurableSpace.measurableSet_bot_iff.1 hs with rfl | rfl <;> simp

/-- A strongly `m`-measurable function with values in a Hausdorff space is constant on the atoms
of `m`: so are its approximating simple functions, whose fibres are `m`-measurable. -/
theorem fpa_eq_of_mem_atom {Ω : Type*} {m : MeasurableSpace Ω} {β : Type*}
    [TopologicalSpace β] [T2Space β] {f : Ω → β} (hf : StronglyMeasurable[m] f) {x y : Ω}
    (hy : y ∈ atom m x) : f y = f x := by
  have key : ∀ n, hf.approx n x = hf.approx n y := fun n =>
    ((hy _ (@SimpleFunc.measurableSet_fiber _ _ m (hf.approx n) (hf.approx n x))).1 rfl).symm
  exact tendsto_nhds_unique (hf.tendsto_approx y) ((hf.tendsto_approx x).congr key)

/-- On a finite space, the real measure of a set is the sum of the masses of its points. -/
theorem fpa_measureReal_eq_sum {Ω : Type*} [Fintype Ω] {mΩ : MeasurableSpace Ω}
    [MeasurableSingletonClass Ω] (ν : Measure Ω) [IsFiniteMeasure ν] (s : Set Ω) :
    ν.real s = ∑ x, s.indicator (fun x => ν.real {x}) x := by
  classical
  have hs : ((Finset.univ.filter (· ∈ s) : Finset Ω) : Set Ω) = s := by ext; simp
  conv_lhs => rw [← hs]
  rw [← sum_measureReal_singleton, Finset.sum_filter]
  simp [Set.indicator_apply]

/-- On a finite probability space, the conditional expectation given a σ-algebra is the average
over the atoms: at a point `ω` of positive mass,
`E [f | m] (ω) = μ (A)⁻¹ Σ_{ω' ∈ A} μ {ω'} f (ω')`, `A` the atom of `ω`. -/
theorem condExp_eq_atom_average {Ω : Type*} [Fintype Ω] {mΩ : MeasurableSpace Ω}
    [DiscreteMeasurableSpace Ω] {μ : Measure Ω} [IsFiniteMeasure μ] {m : MeasurableSpace Ω}
    (hm : m ≤ mΩ) {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    [CompleteSpace X] (f : Ω → X) {ω : Ω} (hω : μ {ω} ≠ 0) :
    μ[f | m] ω =
      (μ.real (atom m ω))⁻¹ • ∑ ω', (atom m ω).indicator (fun ω' => μ.real {ω'} • f ω') ω' := by
  set A := atom m ω
  have hAm : MeasurableSet[mΩ] A := hm _ (measurableSet_atom m ω)
  -- `E [f | m]` is constant on the atom `A`, and has the same integral over `A` as `f`
  have hconst : ∀ ω' ∈ A, μ[f | m] ω' = μ[f | m] ω := fun ω' h =>
    fpa_eq_of_mem_atom stronglyMeasurable_condExp h
  have hint := setIntegral_condExp hm (Integrable.of_finite (f := f) (μ := μ))
    (measurableSet_atom m ω)
  rw [← integral_indicator hAm, ← integral_indicator hAm, integral_fintype Integrable.of_finite,
    integral_fintype Integrable.of_finite] at hint
  have h1 : ∑ x, μ.real {x} • A.indicator (μ[f | m]) x = μ.real A • μ[f | m] ω := by
    rw [fpa_measureReal_eq_sum μ A, Finset.sum_smul]
    refine Finset.sum_congr rfl fun x _ => ?_
    by_cases hx : x ∈ A
    · simp [Set.indicator_of_mem hx, hconst x hx]
    · simp [Set.indicator_of_notMem hx]
  have hpos : 0 < μ.real A :=
    lt_of_lt_of_le (ENNReal.toReal_pos hω (measure_ne_top μ _))
      (measureReal_mono (Set.singleton_subset_iff.2 (mem_atom_self m ω)))
  rw [h1] at hint
  simp_rw [Set.indicator_smul_apply]
  rw [← hint, smul_smul, inv_mul_cancel₀ hpos.ne', one_smul]

variable (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

/-- The UMD inequality restricted to martingales on finite probability spaces. -/
def IsFiniteUMDBound (p : ℝ) (β : ℝ≥0∞) : Prop :=
  ∀ (Ω : Type) [Fintype Ω] (mΩ : MeasurableSpace Ω) [DiscreteMeasurableSpace Ω] (μ : Measure Ω)
    [IsProbabilityMeasure μ] (ℱ : Filtration ℕ mΩ) (Y : ℕ → Ω → X) (σ : ℕ → Ω → ℝ),
    Martingale Y ℱ μ → (∀ ω, Y 0 ω = 0) → (∀ n ω, σ n ω = 1 ∨ σ n ω = -1) →
      (∀ k, StronglyMeasurable[ℱ k] (σ (k + 1))) →
      ∀ n, eLpNorm (fun ω => ‖martingaleTransform σ Y n ω‖) (ENNReal.ofReal p) μ ≤
        β * eLpNorm (fun ω => ‖Y n ω‖) (ENNReal.ofReal p) μ

variable {X}

end BanachProbability
