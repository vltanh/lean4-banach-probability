module

public import BanachProbability.UMD.Defs

/-!
# Martingales on finite probability spaces

On a finite probability space every σ-algebra is generated by its atoms
(`MeasureTheory.MeasurableSpace` on a `Fintype`), and the conditional expectation given it is the
average over atoms (`condExp_eq_atom_average`). A martingale and predictable signs on such a space
are a finite *model* of a martingale transform. This file defines

* `atom m ω`: the points that no `m`-measurable set separates from `ω`;
* `IsFiniteUMDBound X p β`: the UMD inequality restricted to finite probability spaces;
* `HasDyadicTransitions μ ℱ n`: the transition probabilities of the filtration `ℱ` up to time `n`
  (the masses of the atoms of `ℱ_0`, and the conditional masses of the atoms of `ℱ_{k+1}` inside
  those of `ℱ_k`) are dyadic rationals with a common denominator,

and proves the perturbation step of Maurey's theorem (Pisier, *Martingales in Banach spaces*
(2016), §5.6; HNVW I, Theorem 4.2.5): the transition probabilities of a finite model can be moved
to dyadic rationals with the same support, the martingale being recomputed as the conditional
expectation of its last value under the new law, so that both sides of the UMD inequality move by
at most a prescribed `η` (`exists_hasDyadicTransitions_approx`; continuity in finitely many
variables). This replaces the quasi-martingale correction of the source.
-/

@[expose] public section

open MeasureTheory
open scoped ENNReal

namespace BanachProbability

/-- The atom of `ω` in the σ-algebra `m`: the points that no `m`-measurable set separates from
`ω`. -/
def atom {Ω : Type*} (m : MeasurableSpace Ω) (ω : Ω) : Set Ω :=
  {ω' | ∀ s, MeasurableSet[m] s → (ω ∈ s ↔ ω' ∈ s)}

theorem mem_atom_self {Ω : Type*} (m : MeasurableSpace Ω) (ω : Ω) : ω ∈ atom m ω :=
  fun _ _ => Iff.rfl

/-- On a finite space, the atoms of a σ-algebra are measurable. -/
theorem measurableSet_atom {Ω : Type*} [Finite Ω] (m : MeasurableSpace Ω) (ω : Ω) :
    MeasurableSet[m] (atom m ω) := by
  sorry

/-- On a finite probability space, the conditional expectation given a σ-algebra is the average
over the atoms: at a point `ω` of positive mass,
`E [f | m] (ω) = μ (A)⁻¹ Σ_{ω' ∈ A} μ {ω'} f (ω')`, `A` the atom of `ω`. -/
theorem condExp_eq_atom_average {Ω : Type*} [Fintype Ω] {mΩ : MeasurableSpace Ω}
    [DiscreteMeasurableSpace Ω] {μ : Measure Ω} [IsFiniteMeasure μ] {m : MeasurableSpace Ω}
    (hm : m ≤ mΩ) {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    [CompleteSpace X] (f : Ω → X) {ω : Ω} (hω : μ {ω} ≠ 0) :
    μ[f | m] ω =
      (μ.real (atom m ω))⁻¹ • ∑ ω', (atom m ω).indicator (fun ω' => μ.real {ω'} • f ω') ω' := by
  sorry

variable (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

/-- The UMD inequality restricted to martingales on finite probability spaces. -/
def IsFiniteUMDBound (p : ℝ) (β : ℝ≥0∞) : Prop :=
  ∀ (Ω : Type) [Fintype Ω] (mΩ : MeasurableSpace Ω) [DiscreteMeasurableSpace Ω] (μ : Measure Ω)
    [IsProbabilityMeasure μ] (ℱ : Filtration ℕ mΩ) (Y : ℕ → Ω → X) (σ : ℕ → Ω → ℝ),
    Martingale Y ℱ μ → (∀ ω, Y 0 ω = 0) → (∀ n ω, σ n ω = 1 ∨ σ n ω = -1) →
      (∀ k, StronglyMeasurable[ℱ k] (σ (k + 1))) →
      ∀ n, eLpNorm (fun ω => ‖martingaleTransform σ Y n ω‖) (ENNReal.ofReal p) μ ≤
        β * eLpNorm (fun ω => ‖Y n ω‖) (ENNReal.ofReal p) μ

variable {X}

/-- The transition probabilities of `ℱ` up to time `n` are dyadic rationals with the common
denominator `2^m`: every atom of `ℱ_0` has mass `j / 2^m`, and every atom of `ℱ_{k+1}`, `k < n`,
has mass `j / 2^m` times that of the atom of `ℱ_k` containing it. -/
def HasDyadicTransitions {Ω : Type*} {mΩ : MeasurableSpace Ω} (μ : Measure Ω)
    (ℱ : Filtration ℕ mΩ) (n : ℕ) : Prop :=
  ∃ m : ℕ, (∀ ω, ∃ j : ℕ, μ.real (atom (ℱ 0) ω) = j / 2 ^ m) ∧
    ∀ k < n, ∀ ω, ∃ j : ℕ, μ.real (atom (ℱ (k + 1)) ω) = j / 2 ^ m * μ.real (atom (ℱ k) ω)

/-- **Dyadic perturbation** of a finite model: for `η > 0` there are a probability `μ'` on the same
finite space, with dyadic transition probabilities for `ℱ` up to time `n`, and a martingale `Y'`
for `ℱ` and `μ'` started at `0` (the conditional expectations of a perturbation of `Y_n` under
`μ'`), such that `‖Y'_n‖_{L^p (μ')} ≤ ‖Y_n‖_{L^p (μ)} + η` and
`‖(σ • Y)_n‖_{L^p (μ)} ≤ ‖(σ • Y')_n‖_{L^p (μ')} + η`. -/
theorem exists_hasDyadicTransitions_approx {Ω : Type} [Finite Ω] {mΩ : MeasurableSpace Ω}
    [DiscreteMeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] {ℱ : Filtration ℕ mΩ}
    {Y : ℕ → Ω → X} {σ : ℕ → Ω → ℝ} (hY : Martingale Y ℱ μ) (hY0 : ∀ ω, Y 0 ω = 0)
    (hσ : ∀ n ω, σ n ω = 1 ∨ σ n ω = -1) (hσm : ∀ k, StronglyMeasurable[ℱ k] (σ (k + 1)))
    {p : ℝ} (hp : 1 ≤ p) (n : ℕ) {η : ℝ} (hη : 0 < η) :
    ∃ (μ' : Measure Ω) (_ : IsProbabilityMeasure μ') (Y' : ℕ → Ω → X),
      HasDyadicTransitions μ' ℱ n ∧ Martingale Y' ℱ μ' ∧ (∀ ω, Y' 0 ω = 0) ∧
      eLpNorm (fun ω => ‖Y' n ω‖) (ENNReal.ofReal p) μ' ≤
        eLpNorm (fun ω => ‖Y n ω‖) (ENNReal.ofReal p) μ + ENNReal.ofReal η ∧
      eLpNorm (fun ω => ‖martingaleTransform σ Y n ω‖) (ENNReal.ofReal p) μ ≤
        eLpNorm (fun ω => ‖martingaleTransform σ Y' n ω‖) (ENNReal.ofReal p) μ' +
          ENNReal.ofReal η := by
  sorry

end BanachProbability
