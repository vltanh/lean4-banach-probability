module

public import BanachProbability.UMD.Defs
public import Mathlib.Analysis.Normed.Module.HahnBanach

/-!
# Martingale transforms as operators on functions on the sign cube

For predictable signs `σ` on the sign cube, the martingale transform is an operator on all functions
`f : (Fin N → Bool) → X`,
`T f = f_0 + Σ_k σ_k (f_{k+1} − f_k)`, `f_k = E [f | ℱ_k]` (`cubeTransform σ f`),
the form (4.12) (p. 283) of T. Hytönen, J. van Neerven, M. Veraar and L. Weis (HNVW), *Analysis in
Banach Spaces I* (2016), with `ε_0 = 1`. HNVW's signs are deterministic; the UMD constants of this
library are defined with predictable signs, and so is `T`. All arguments are about one fixed
transform `T`, for which predictable signs cost nothing.

* The martingale generated by `T f` has the differences `σ_k (f_{k+1} − f_k)`
  (`condAvg_succ_sub_cubeTransform`), and transforms compose by multiplying the multipliers
  (`cubeTransform_cubeTransform`).
* `IsTransformBound X σ p K`: `‖T f‖_p ≤ K ‖f‖_p` for every `f` with values in `X`.
* HNVW, Lemma 4.2.8 (p. 283–284): a dyadic UMD constant bounds `T` on all functions, with the same
  constant (`IsDyadicUMDBound.isTransformBound`), although the martingales in its definition start
  at `0`; conversely bounds of the operators `T` give a dyadic UMD constant, because `T` applied to
  a Paley–Walsh martingale is its transform (`isDyadicUMDBound_of_isTransformBound`).
* HNVW, Lemma 3.5.3 (p. 221–222), the adjoint: `⟨T f, g⟩ = ⟨f, T g⟩` for `g` with values in the
  dual space (`avg_apply_cubeTransform`), hence `‖T‖_{L^p (X)} = ‖T‖_{L^{p'} (X*)}`
  (`isTransformBound_iff_dual`).

The space of values is a real normed space; no completeness is needed.
-/

@[expose] public section

namespace BanachProbability

open SignCube

variable {N : ℕ}

section CondAvg

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

theorem cbt_condAvg_add (k : ℕ) (f g : (Fin N → Bool) → E) :
    condAvg k (f + g) = condAvg k f + condAvg k g := by
  funext ε
  simp only [condAvg, Pi.add_apply, Finset.sum_add_distrib, smul_add]

theorem cbt_condAvg_sub (k : ℕ) (f g : (Fin N → Bool) → E) :
    condAvg k (f - g) = condAvg k f - condAvg k g := by
  funext ε
  simp only [condAvg, Pi.sub_apply, Finset.sum_sub_distrib, smul_sub]

/-- `E [f | ℱ_k]` depends only on the signs `ε_j`, `j < k`. -/
theorem cbt_condAvg_eq_of_agree (k : ℕ) (f : (Fin N → Bool) → E) (ε ε' : Fin N → Bool)
    (h : ∀ j : Fin N, j.val < k → ε j = ε' j) : condAvg k f ε = condAvg k f ε' := by
  have hs : ∀ η, splice k ε η = splice k ε' η := fun η => by
    funext j
    simp only [splice]
    split_ifs with hj
    · exact h j hj
    · rfl
  simp only [condAvg, hs]

/-- `E [f | ℱ_k] = f` for `k ≥ N`. -/
theorem cbt_condAvg_of_le {k : ℕ} (hk : N ≤ k) (f : (Fin N → Bool) → E) : condAvg k f = f :=
  condAvg_of_isAdapted fun ε ε' h => by
    rw [show ε = ε' from funext fun j => h j (j.isLt.trans_le hk)]

/-- `E [E [f | ℱ_k] | ℱ_l] = E [f | ℱ_k]` for `k ≤ l`. -/
theorem cbt_condAvg_condAvg_of_le {k l : ℕ} (h : k ≤ l) (f : (Fin N → Bool) → E) :
    condAvg l (condAvg k f) = condAvg k f :=
  condAvg_of_isAdapted fun ε ε' hε =>
    cbt_condAvg_eq_of_agree k f ε ε' fun j hj => hε j (hj.trans_le h)

/-- The martingale `n ↦ E [f | ℱ_n]` generated by a function is a Paley–Walsh martingale started at
its constant initial value (HNVW, Proposition 3.1.10, p. 169). -/
theorem cbt_exists_paleyWalsh (f : (Fin N → Bool) → E) :
    ∃ ξ : Fin N → (Fin N → Bool) → E, IsPredictable ξ ∧
      ∀ n ε, condAvg n f ε = condAvg 0 f ε + paleyWalsh ξ n ε :=
  exists_paleyWalsh_of_isCubeMartingale (M := fun n => condAvg n f)
    ⟨fun n _ _ h => cbt_condAvg_eq_of_agree n f _ _ h, fun n => condAvg_condAvg (Nat.le_succ n) f⟩

/-- HNVW, Lemma 3.5.2 (p. 221), for scalar multipliers on the sign cube:
`E [v f | ℱ_k] = v E [f | ℱ_k]` for `v` depending only on the signs `ε_j`, `j < k`. -/
theorem cbt_condAvg_smul {k : ℕ} {v : (Fin N → Bool) → ℝ}
    (hv : ∀ ε ε' : Fin N → Bool, (∀ j : Fin N, j.val < k → ε j = ε' j) → v ε = v ε')
    (f : (Fin N → Bool) → E) :
    condAvg k (fun ε => v ε • f ε) = fun ε => v ε • condAvg k f ε := by
  funext ε
  have h : ∀ η, v (splice k ε η) = v ε := fun η => hv _ _ fun j hj => by simp [splice, hj]
  simp only [condAvg, h, ← Finset.smul_sum]
  exact smul_comm _ _ _

end CondAvg

section Transform

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

/-- The martingale transform `T f = f_0 + Σ_k σ_k (f_{k+1} − f_k)`, `f_k = E [f | ℱ_k]`, as an
operator on functions on the sign cube: HNVW, (4.12) (p. 283) and Definition 3.5.1 (p. 220), with
`ε_0 = 1`, the initial value `f_0` in the place of `f_{−∞}` and real multipliers `σ`, predictable in
the applications (HNVW's UMD constants are about deterministic signs; predictable ones cost
nothing, because every argument is about one fixed transform). -/
noncomputable def cubeTransform (σ : Fin N → (Fin N → Bool) → ℝ) (f : (Fin N → Bool) → E)
    (ε : Fin N → Bool) : E :=
  condAvg 0 f ε + ∑ k : Fin N, σ k ε • (condAvg (k.val + 1) f ε - condAvg k.val f ε)

variable {σ v : Fin N → (Fin N → Bool) → ℝ}

theorem cubeTransform_sub (σ : Fin N → (Fin N → Bool) → ℝ) (f g : (Fin N → Bool) → E) :
    cubeTransform σ (f - g) = cubeTransform σ f - cubeTransform σ g := by
  funext ε
  simp only [cubeTransform, cbt_condAvg_sub, Pi.sub_apply, smul_sub, Finset.sum_sub_distrib]
  abel

theorem cubeTransform_zero (σ : Fin N → (Fin N → Bool) → ℝ) :
    cubeTransform σ (0 : (Fin N → Bool) → E) = 0 := by
  have h := cubeTransform_sub σ (0 : (Fin N → Bool) → E) 0
  rwa [sub_self, sub_self] at h

/-- The transform of `f = f_0 + Σ_k ε_k ξ_k` is `f_0 + Σ_k σ_k ε_k ξ_k`. -/
theorem cbt_cubeTransform_eq (σ : Fin N → (Fin N → Bool) → ℝ) {f : (Fin N → Bool) → E}
    {ξ : Fin N → (Fin N → Bool) → E}
    (hf : ∀ n ε, condAvg n f ε = condAvg 0 f ε + paleyWalsh ξ n ε) (ε : Fin N → Bool) :
    cubeTransform σ f ε = condAvg 0 f ε + paleyWalsh (fun k ε => σ k ε • ξ k ε) N ε := by
  rw [cubeTransform, paleyWalsh_of_le _ le_rfl]
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [hf (k.val + 1), hf k.val, add_sub_add_left_eq_sub, paleyWalsh_succ, dite_eq_left k.isLt,
    add_sub_cancel_left, smul_comm]

/-- The martingale generated by the transform of `f = f_0 + Σ_k ε_k ξ_k`. -/
theorem cbt_condAvg_cubeTransform_eq (hσ : IsPredictable σ) {f : (Fin N → Bool) → E}
    {ξ : Fin N → (Fin N → Bool) → E} (hξ : IsPredictable ξ)
    (hf : ∀ n ε, condAvg n f ε = condAvg 0 f ε + paleyWalsh ξ n ε) (n : ℕ) (ε : Fin N → Bool) :
    condAvg n (cubeTransform σ f) ε =
      condAvg 0 f ε + paleyWalsh (fun k ε => σ k ε • ξ k ε) n ε := by
  rw [show cubeTransform σ f = condAvg 0 f + paleyWalsh (fun k ε => σ k ε • ξ k ε) N from
      funext (cbt_cubeTransform_eq σ hf), cbt_condAvg_add,
    cbt_condAvg_condAvg_of_le (Nat.zero_le n), condAvg_paleyWalsh (hσ.smul hξ), Pi.add_apply]
  rcases le_total n N with h | h
  · rw [min_eq_left h]
  · rw [min_eq_right h, paleyWalsh_of_le _ le_rfl, paleyWalsh_of_le _ h]

/-- The transform fixes the initial value. -/
theorem condAvg_zero_cubeTransform (hσ : IsPredictable σ) (f : (Fin N → Bool) → E) :
    condAvg 0 (cubeTransform σ f) = condAvg 0 f := by
  obtain ⟨ξ, hξ, hf⟩ := cbt_exists_paleyWalsh f
  funext ε
  rw [cbt_condAvg_cubeTransform_eq hσ hξ hf, paleyWalsh_zero, add_zero]

/-- The transform multiplies the martingale differences by the signs: `d (T f)_n = σ_n df_n`. -/
theorem condAvg_succ_sub_cubeTransform (hσ : IsPredictable σ) (f : (Fin N → Bool) → E) (n : ℕ)
    (ε : Fin N → Bool) :
    condAvg (n + 1) (cubeTransform σ f) ε - condAvg n (cubeTransform σ f) ε =
      if h : n < N then σ ⟨n, h⟩ ε • (condAvg (n + 1) f ε - condAvg n f ε) else 0 := by
  obtain ⟨ξ, hξ, hf⟩ := cbt_exists_paleyWalsh f
  rw [cbt_condAvg_cubeTransform_eq hσ hξ hf, cbt_condAvg_cubeTransform_eq hσ hξ hf,
    add_sub_add_left_eq_sub, paleyWalsh_succ, add_sub_cancel_left]
  split_ifs with h
  · rw [hf (n + 1), hf n, add_sub_add_left_eq_sub, paleyWalsh_succ, dite_eq_left h,
      add_sub_cancel_left, smul_comm]
  · rfl

/-- Transforms compose by multiplication of the multipliers. -/
theorem cubeTransform_cubeTransform (σ : Fin N → (Fin N → Bool) → ℝ) (hv : IsPredictable v)
    (f : (Fin N → Bool) → E) :
    cubeTransform σ (cubeTransform v f) = cubeTransform (fun k ε => σ k ε * v k ε) f := by
  funext ε
  rw [cubeTransform, cubeTransform, condAvg_zero_cubeTransform hv]
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [condAvg_succ_sub_cubeTransform hv, dite_eq_left k.isLt, smul_smul]

/-- A constant function is a fixed point of the transform. -/
theorem cubeTransform_const (σ : Fin N → (Fin N → Bool) → ℝ) (c : E) :
    cubeTransform σ (fun _ => c) = fun _ => c := by
  have h : ∀ k, condAvg k (fun _ : Fin N → Bool => c) = fun _ => c := fun k =>
    condAvg_of_isAdapted fun _ _ _ => rfl
  funext ε
  simp [cubeTransform, h]

/-- The transform of a Paley–Walsh martingale started at `0` is the martingale of the family
`σ ξ`. -/
theorem cubeTransform_paleyWalsh (σ : Fin N → (Fin N → Bool) → ℝ)
    {ξ : Fin N → (Fin N → Bool) → E} (hξ : IsPredictable ξ) (n : ℕ) :
    cubeTransform σ (paleyWalsh ξ n) = paleyWalsh (fun k ε => σ k ε • ξ k ε) n := by
  funext ε
  rw [cubeTransform]
  simp only [condAvg_paleyWalsh hξ, Nat.zero_min, paleyWalsh_zero, zero_add]
  rw [paleyWalsh, Finset.sum_filter]
  refine Finset.sum_congr rfl fun k _ => ?_
  split_ifs with h
  · rw [min_eq_left (Nat.succ_le_of_lt h), min_eq_left h.le, paleyWalsh_succ,
      dite_eq_left k.isLt, add_sub_cancel_left, smul_comm]
  · rw [min_eq_right (not_lt.mp h), min_eq_right (by omega), sub_self, smul_zero]

end Transform

section Bound

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] {σ : Fin N → (Fin N → Bool) → ℝ}

variable (X) in
/-- The transform by `σ` is bounded on `L^p (X)` with constant `K`: `‖T f‖_p ≤ K ‖f‖_p` for every
function `f` on the sign cube with values in `X`. -/
def IsTransformBound (σ : Fin N → (Fin N → Bool) → ℝ) (p K : ℝ) : Prop :=
  ∀ f : (Fin N → Bool) → X,
    SignCube.lpNorm (fun x => ‖x‖) p (cubeTransform σ f) ≤
      K * SignCube.lpNorm (fun x => ‖x‖) p f

theorem IsTransformBound.mono {p K K' : ℝ} (h : IsTransformBound X σ p K) (hK : K ≤ K') :
    IsTransformBound X σ p K' := fun f =>
  (h f).trans (mul_le_mul_of_nonneg_right hK (lpNorm_nonneg (fun x => norm_nonneg x) p f))

/-- Transforms fix constants, so a bound of a transform on a nonzero space is at least `1`. (For
general multipliers `v` HNVW have Proposition 3.5.10, p. 226: `‖v‖_∞ ≤ 2^{1/q} K`; for signs,
`‖v‖_∞ = 1 ≤ K` is all that is used.) -/
theorem IsTransformBound.one_le [Nontrivial X] {p K : ℝ} (hp : 0 < p)
    (h : IsTransformBound X σ p K) : 1 ≤ K := by
  obtain ⟨x, hx⟩ := exists_ne (0 : X)
  have key := h fun _ => x
  rw [cubeTransform_const, lpNorm_const (norm_nonneg x) hp] at key
  exact le_of_mul_le_mul_right (by linarith) (norm_pos_iff.mpr hx)

/-! ### Lemma 4.2.8: martingales that do not start at zero -/

/-- The family `c, r ξ_0, r ξ_1, …` on the cube with one more sign `r` in front: the martingale
differences `dg_1 = f_0 ⊗ r`, `dg_n = df_{n−1} ⊗ r` in the proof of HNVW, Lemma 4.2.8 (p. 284),
divided by their own signs. -/
noncomputable def cbtCons (c : X) (ξ : Fin N → (Fin N → Bool) → X) :
    Fin (N + 1) → (Fin (N + 1) → Bool) → X :=
  Fin.cons (fun _ => c) fun k ω => coin (ω 0) • ξ k (Fin.tail ω)

theorem cbt_isPredictable_cons (c : X) {ξ : Fin N → (Fin N → Bool) → X} (hξ : IsPredictable ξ) :
    IsPredictable (cbtCons c ξ) := by
  intro k ω ω' h
  induction k using Fin.cases with
  | zero => rfl
  | succ k =>
    simp only [cbtCons, Fin.cons_succ]
    rw [h 0 (Fin.succ_pos k), hξ k (Fin.tail ω) (Fin.tail ω') fun j hj =>
      h j.succ (Fin.succ_lt_succ_iff.mpr hj)]

/-- `g_{n+1} = r f_n` for the martingale `g` of the family `c, r ξ_0, r ξ_1, …` and
`f_n = c + Σ_{k<n} ε_k ξ_k` (HNVW, proof of Lemma 4.2.8, p. 284). -/
theorem cbt_paleyWalsh_cons (c : X) (ξ : Fin N → (Fin N → Bool) → X) (n : ℕ)
    (ω : Fin (N + 1) → Bool) :
    paleyWalsh (cbtCons c ξ) (n + 1) ω =
      coin (ω 0) • (c + paleyWalsh ξ n (Fin.tail ω)) := by
  induction n with
  | zero =>
    rw [paleyWalsh_succ, dite_eq_left (Nat.succ_pos N), paleyWalsh_zero, paleyWalsh_zero, zero_add,
      add_zero]
    rfl
  | succ n ih =>
    rw [paleyWalsh_succ, ih, paleyWalsh_succ ξ n]
    by_cases h : n < N
    · rw [dite_eq_left h, dite_eq_left (Nat.succ_lt_succ h),
        show (⟨n + 1, Nat.succ_lt_succ h⟩ : Fin (N + 1)) = Fin.succ ⟨n, h⟩ from rfl]
      simp only [cbtCons, Fin.cons_succ, Fin.tail, smul_add, add_assoc]
      rw [smul_comm]
    · rw [dite_eq_right h, dite_eq_right (fun h' => h (Nat.lt_of_succ_lt_succ h')), add_zero,
        add_zero]

/-- `g_{n+1} = r f_n` for the martingale `f_n = E [f | ℱ_n]` generated by a function. -/
theorem cbt_paleyWalsh_cons_condAvg {f : (Fin N → Bool) → X} {c : X}
    (hc : ∀ ε, condAvg 0 f ε = c) {ξ : Fin N → (Fin N → Bool) → X}
    (hf : ∀ n ε, condAvg n f ε = condAvg 0 f ε + paleyWalsh ξ n ε) (n : ℕ)
    (ω : Fin (N + 1) → Bool) :
    paleyWalsh (cbtCons c ξ) (n + 1) ω = coin (ω 0) • condAvg n f (Fin.tail ω) := by
  rw [cbt_paleyWalsh_cons, hf, hc]

/-- Averages over the cube with one more sign in front, of functions not depending on it. -/
theorem cbt_avg_tail (G : (Fin N → Bool) → ℝ) :
    avg (fun ω : Fin (N + 1) → Bool => G (Fin.tail ω)) = avg G := by
  rw [avg_succ]
  simp only [Fin.tail_cons]
  ring

/-- The common factor `r` is invisible to the norms (HNVW, proof of Lemma 4.2.8, p. 284). -/
theorem cbt_lpNorm_coin_smul_tail (p : ℝ) (h : (Fin N → Bool) → X) :
    SignCube.lpNorm (fun x => ‖x‖) p
        (fun ω : Fin (N + 1) → Bool => coin (ω 0) • h (Fin.tail ω)) =
      SignCube.lpNorm (fun x => ‖x‖) p h := by
  simp only [SignCube.lpNorm, norm_smul, Real.norm_eq_abs, abs_coin, one_mul]
  rw [cbt_avg_tail fun ε => ‖h ε‖ ^ p]

/-- **HNVW, Lemma 4.2.8** (p. 283–284), on the sign cube: a dyadic UMD constant, defined by
martingales started at `0`, bounds the transform `T f = f_0 + Σ_k σ_k (f_{k+1} − f_k)` of every
function, with the same constant. As in the book, `f` is multiplied by one more fair sign `r`, put
in front of the others: `g_0 = 0`, `g_{n+1} = r f_n` is a Paley–Walsh martingale started at `0`,
transformed by the signs `1, σ_0, σ_1, …`. -/
theorem IsDyadicUMDBound.isTransformBound {p K : ℝ} (hK : 0 ≤ K)
    (h : IsDyadicUMDBound X p (ENNReal.ofReal K)) (hσ : IsPredictable σ)
    (hσ1 : ∀ k ε, σ k ε = 1 ∨ σ k ε = -1) : IsTransformBound X σ p K := by
  intro f
  obtain ⟨ξ, hξ, hf⟩ := cbt_exists_paleyWalsh f
  set c := condAvg 0 f fun _ => false with hc
  have hc' : ∀ ε, condAvg 0 f ε = c := fun ε => cbt_condAvg_eq_of_agree 0 f _ _ (by simp)
  -- the signs `1, σ_0, σ_1, …`
  let σ' : Fin (N + 1) → (Fin (N + 1) → Bool) → ℝ := Fin.cons (fun _ => 1) fun k ω =>
    σ k (Fin.tail ω)
  have hσ' : IsPredictable σ' := by
    intro k ω ω' hω
    induction k using Fin.cases with
    | zero => rfl
    | succ k =>
      exact hσ k (Fin.tail ω) (Fin.tail ω') fun j hj =>
        hω j.succ (Fin.succ_lt_succ_iff.mpr hj)
  have hσ'1 : ∀ k ω, σ' k ω = 1 ∨ σ' k ω = -1 := by
    intro k ω
    induction k using Fin.cases with
    | zero => exact Or.inl rfl
    | succ k => exact hσ1 k (Fin.tail ω)
  have key := h (N + 1) (cbtCons c ξ) σ' (cbt_isPredictable_cons c hξ) hσ' hσ'1 (N + 1)
  have e : (fun k ω => σ' k ω • cbtCons c ξ k ω) = cbtCons c fun k ε => σ k ε • ξ k ε := by
    funext k ω
    induction k using Fin.cases with
    | zero => exact one_smul ℝ c
    | succ k =>
      simp only [σ', cbtCons, Fin.cons_succ]
      exact smul_comm _ _ _
  have e1 : paleyWalsh (cbtCons c ξ) (N + 1) = fun ω => coin (ω 0) • f (Fin.tail ω) := by
    funext ω
    rw [cbt_paleyWalsh_cons_condAvg hc' hf, cbt_condAvg_of_le le_rfl]
  have e2 : paleyWalsh (cbtCons c fun k ε => σ k ε • ξ k ε) (N + 1) =
      fun ω => coin (ω 0) • cubeTransform σ f (Fin.tail ω) := by
    funext ω
    rw [cbt_paleyWalsh_cons, cbt_cubeTransform_eq σ hf, hc']
  rw [e, e1, e2, cbt_lpNorm_coin_smul_tail, cbt_lpNorm_coin_smul_tail, ← ENNReal.ofReal_mul hK,
    ENNReal.ofReal_le_ofReal_iff
      (mul_nonneg hK (lpNorm_nonneg (fun x => norm_nonneg x) p f))] at key
  exact key

/-- Conversely (HNVW, Lemma 4.2.8, p. 283), bounds of the transforms by predictable signs on all
sign cubes give a dyadic UMD constant. -/
theorem isDyadicUMDBound_of_isTransformBound {p K : ℝ} (hK : 0 ≤ K)
    (h : ∀ (N : ℕ) (σ : Fin N → (Fin N → Bool) → ℝ), IsPredictable σ →
      (∀ k ε, σ k ε = 1 ∨ σ k ε = -1) → IsTransformBound X σ p K) :
    IsDyadicUMDBound X p (ENNReal.ofReal K) := by
  intro N ξ σ hξ hσ hσ1 n
  have key := h N σ hσ hσ1 (paleyWalsh ξ n)
  rw [cubeTransform_paleyWalsh σ hξ] at key
  rw [← ENNReal.ofReal_mul hK]
  exact ENNReal.ofReal_le_ofReal key

end Bound

section Adjoint

/-! ### Lemma 3.5.3: the adjoint -/

/-- Reindexing by the bijection `(ε, ε') ↦ (splice m ε ε', splice m ε' ε)` of pairs of sign
vectors: `Σ_ε Σ_{ε'} G ε (splice m ε ε') = Σ_ε Σ_{ε'} G (splice m ε ε') ε`. -/
private theorem cbt_sum_sum_splice (m : ℕ) (G : (Fin N → Bool) → (Fin N → Bool) → ℝ) :
    ∑ ε : Fin N → Bool, ∑ ε' : Fin N → Bool, G ε (splice m ε ε') =
      ∑ ε : Fin N → Bool, ∑ ε' : Fin N → Bool, G (splice m ε ε') ε := by
  have hs : ∀ a b : Fin N → Bool, splice m (splice m a b) (splice m b a) = a := fun a b => by
    funext j
    simp only [splice]
    split_ifs <;> rfl
  let e : (Fin N → Bool) × (Fin N → Bool) ≃ (Fin N → Bool) × (Fin N → Bool) :=
    { toFun := fun x => (splice m x.1 x.2, splice m x.2 x.1)
      invFun := fun x => (splice m x.1 x.2, splice m x.2 x.1)
      left_inv := fun x => Prod.ext (hs x.1 x.2) (hs x.2 x.1)
      right_inv := fun x => Prod.ext (hs x.1 x.2) (hs x.2 x.1) }
  rw [← Fintype.sum_prod_type', ← Fintype.sum_prod_type',
    ← Equiv.sum_comp e fun x => G x.1 (splice m x.1 x.2)]
  exact Finset.sum_congr rfl fun x _ => by simp only [e, Equiv.coe_fn_mk, hs]

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] {σ : Fin N → (Fin N → Bool) → ℝ}

/-- Conditional expectations are self-adjoint: `⟨g, E [f | ℱ_m]⟩ = ⟨E [g | ℱ_m], f⟩`. -/
theorem cbt_avg_apply_condAvg (m : ℕ) (g : (Fin N → Bool) → StrongDual ℝ X)
    (f : (Fin N → Bool) → X) :
    avg (fun ε => g ε (condAvg m f ε)) = avg (fun ε => condAvg m g ε (f ε)) := by
  simp only [avg, condAvg, map_smul, map_sum, smul_apply,
    sum_apply, smul_eq_mul, ← Finset.mul_sum]
  rw [cbt_sum_sum_splice m fun ε η => g ε (f η)]

/-- The martingale differences with the initial value in front: `f_0, df_1, df_2, …`. -/
private noncomputable def cbtDiff {E : Type*} [AddCommGroup E] [Module ℝ E]
    (f : (Fin N → Bool) → E) : ℕ → (Fin N → Bool) → E
  | 0 => condAvg 0 f
  | k + 1 => condAvg (k + 1) f - condAvg k f

/-- The multipliers with `1` in front: `1, σ_0, σ_1, …`. -/
private noncomputable def cbtSign (σ : Fin N → (Fin N → Bool) → ℝ) : ℕ → (Fin N → Bool) → ℝ
  | 0 => fun _ => 1
  | k + 1 => fun ε => if h : k < N then σ ⟨k, h⟩ ε else 1

/-- `T f = Σ_i s_i (f_0, df_1, …)_i`, with the signs `s = (1, σ_0, σ_1, …)`. -/
private theorem cbt_cubeTransform_eq_sum {E : Type*} [AddCommGroup E] [Module ℝ E]
    (σ : Fin N → (Fin N → Bool) → ℝ) (f : (Fin N → Bool) → E) (ε : Fin N → Bool) :
    cubeTransform σ f ε = ∑ i ∈ Finset.range (N + 1), cbtSign σ i ε • cbtDiff f i ε := by
  rw [Finset.sum_range_succ', add_comm, Finset.sum_range, cubeTransform]
  simp [cbtSign, cbtDiff]

/-- `f = f_0 + Σ_k df_k`. -/
private theorem cbt_eq_sum {E : Type*} [AddCommGroup E] [Module ℝ E]
    (f : (Fin N → Bool) → E) (ε : Fin N → Bool) :
    f ε = ∑ i ∈ Finset.range (N + 1), cbtDiff f i ε := by
  rw [Finset.sum_range_succ', add_comm]
  simp only [cbtDiff, Pi.sub_apply]
  rw [Finset.sum_range_sub fun k => condAvg k f ε, cbt_condAvg_of_le le_rfl, add_sub_cancel]

/-- `dh_i = s_i df_i` is `ℱ_i`-measurable and `E [dh_i | ℱ_l] = 0` for `l < i`. -/
private theorem cbt_condAvg_diff {E : Type*} [AddCommGroup E] [Module ℝ E]
    (hσ : IsPredictable σ) (f : (Fin N → Bool) → E) (i : ℕ) :
    condAvg i (fun ε => cbtSign σ i ε • cbtDiff f i ε) =
        (fun ε => cbtSign σ i ε • cbtDiff f i ε) ∧
      ∀ l < i, condAvg l (fun ε => cbtSign σ i ε • cbtDiff f i ε) = 0 := by
  cases i with
  | zero =>
    simp only [cbtSign, cbtDiff, one_smul]
    exact ⟨condAvg_condAvg le_rfl f, fun l hl => absurd hl (Nat.not_lt_zero l)⟩
  | succ k =>
    have hs : ∀ l, k ≤ l → ∀ ε ε' : Fin N → Bool, (∀ j : Fin N, j.val < l → ε j = ε' j) →
        cbtSign σ (k + 1) ε = cbtSign σ (k + 1) ε' := by
      intro l hl ε ε' h
      simp only [cbtSign]
      split_ifs with hk
      · exact hσ ⟨k, hk⟩ ε ε' fun j hj => h j (lt_of_lt_of_le (Fin.lt_def.mp hj) hl)
      · rfl
    constructor
    · rw [cbt_condAvg_smul (hs (k + 1) (Nat.le_succ k))]
      simp only [cbtDiff, cbt_condAvg_sub, condAvg_condAvg le_rfl,
        cbt_condAvg_condAvg_of_le (Nat.le_succ k)]
    · intro l hl
      have hlk : l ≤ k := Nat.lt_succ_iff.mp hl
      rw [← condAvg_condAvg hlk, cbt_condAvg_smul (hs k le_rfl)]
      have h0 : condAvg k (cbtDiff f (k + 1)) = 0 := by
        rw [cbtDiff, cbt_condAvg_sub, condAvg_condAvg (Nat.le_succ k), condAvg_condAvg le_rfl,
          sub_self]
      simp only [h0, Pi.zero_apply, smul_zero]
      exact condAvg_of_isAdapted fun _ _ _ => rfl

/-- The cancellation of the cross terms in the proof of HNVW, Lemma 3.5.3 (p. 222): if `u_i` and
`v_i` are `ℱ_i`-measurable and have conditional expectation `0` given `ℱ_l`, `l < i`, then
`⟨Σ_i u_i, Σ_j v_j⟩ = Σ_i ⟨u_i, v_i⟩`. For `i < j`,
`⟨u_i, v_j⟩ = ⟨E [u_i | ℱ_i], v_j⟩ = ⟨u_i, E [v_j | ℱ_i]⟩ = 0`, and for `i > j` likewise. (The book
writes `v_j = (E_j − E_{j−1}) g` and moves `E_j − E_{j−1}` to the other side.) -/
private theorem cbt_avg_sum_sum {n : ℕ} {u : ℕ → (Fin N → Bool) → X}
    {v : ℕ → (Fin N → Bool) → StrongDual ℝ X}
    (hu : ∀ i, condAvg i (u i) = u i ∧ ∀ l < i, condAvg l (u i) = 0)
    (hv : ∀ i, condAvg i (v i) = v i ∧ ∀ l < i, condAvg l (v i) = 0) :
    avg (fun ε => (∑ j ∈ Finset.range n, v j ε) (∑ i ∈ Finset.range n, u i ε)) =
      ∑ i ∈ Finset.range n, avg (fun ε => v i ε (u i ε)) := by
  have hcross : ∀ i j, i ≠ j → avg (fun ε => v j ε (u i ε)) = 0 := by
    intro i j hij
    rcases lt_or_gt_of_ne hij with h | h
    · rw [← (hu i).1, cbt_avg_apply_condAvg, (hv j).2 i h]
      simp
    · rw [← (hv j).1, ← cbt_avg_apply_condAvg, (hu i).2 j h]
      simp
  simp only [sum_apply, map_sum]
  rw [avg_sum]
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [avg_sum, Finset.sum_eq_single_of_mem i hi fun j _ hij => hcross i j hij.symm]

/-- **HNVW, Lemma 3.5.3** (p. 221–222), the adjoint of a martingale transform:
`⟨T f, g⟩ = ⟨f, T g⟩` for `g` with values in the dual space (the adjoint of the multiplication by a
real sign is the multiplication by the same sign). -/
theorem avg_apply_cubeTransform (hσ : IsPredictable σ) (g : (Fin N → Bool) → StrongDual ℝ X)
    (f : (Fin N → Bool) → X) :
    avg (fun ε => g ε (cubeTransform σ f ε)) = avg (fun ε => cubeTransform σ g ε (f ε)) := by
  have h1 : ∀ {E : Type _} [AddCommGroup E] [Module ℝ E] (f : (Fin N → Bool) → E) (i : ℕ),
      condAvg i (cbtDiff f i) = cbtDiff f i ∧ ∀ l < i, condAvg l (cbtDiff f i) = 0 := by
    intro E _ _ f i
    have := cbt_condAvg_diff (σ := fun _ _ => 1) (fun _ _ _ _ => rfl) f i
    have hs : ∀ ε, cbtSign (fun _ _ => 1 : Fin N → (Fin N → Bool) → ℝ) i ε = 1 := by
      intro ε
      cases i <;> simp [cbtSign]
    simpa only [hs, one_smul] using this
  calc avg (fun ε => g ε (cubeTransform σ f ε))
      = avg (fun ε => (∑ j ∈ Finset.range (N + 1), cbtDiff g j ε)
          (∑ i ∈ Finset.range (N + 1), cbtSign σ i ε • cbtDiff f i ε)) := by
        simp only [← cbt_cubeTransform_eq_sum, ← cbt_eq_sum]
    _ = ∑ i ∈ Finset.range (N + 1), avg (fun ε => cbtDiff g i ε (cbtSign σ i ε • cbtDiff f i ε)) :=
        cbt_avg_sum_sum (u := fun i ε => cbtSign σ i ε • cbtDiff f i ε)
          (cbt_condAvg_diff hσ f) (h1 g)
    _ = ∑ i ∈ Finset.range (N + 1),
          avg (fun ε => (cbtSign σ i ε • cbtDiff g i ε) (cbtDiff f i ε)) := by
        simp only [map_smul, smul_apply]
    _ = avg (fun ε => (∑ j ∈ Finset.range (N + 1), cbtSign σ j ε • cbtDiff g j ε)
          (∑ i ∈ Finset.range (N + 1), cbtDiff f i ε)) :=
        (cbt_avg_sum_sum (v := fun i ε => cbtSign σ i ε • cbtDiff g i ε)
          (h1 f) (cbt_condAvg_diff hσ g)).symm
    _ = avg (fun ε => cubeTransform σ g ε (f ε)) := by
        simp only [← cbt_cubeTransform_eq_sum, ← cbt_eq_sum]

/-! ### Duality of the norms

`L^p (X)` and `L^{p'} (X*)` norm each other; on the finite cube this is done point by point, with
near-norming vectors, resp. Hahn–Banach norming functionals. -/

/-- Hölder's inequality on the sign cube. -/
private theorem cbt_avg_mul_le {p p' : ℝ} (hp : p.HolderConjugate p') {u v : (Fin N → Bool) → ℝ}
    (hu : ∀ ε, 0 ≤ u ε) (hv : ∀ ε, 0 ≤ v ε) :
    avg (fun ε => u ε * v ε) ≤
      avg (fun ε => u ε ^ p) ^ (1 / p) * avg (fun ε => v ε ^ p') ^ (1 / p') := by
  have h := Real.inner_le_Lp_mul_Lq_of_nonneg Finset.univ hp (fun ε _ => hu ε) (fun ε _ => hv ε)
  have h2 : (0 : ℝ) < 2 ^ N := by positivity
  have e : (1 : ℝ) / p + 1 / p' = 1 := by
    rw [one_div, one_div]
    exact hp.inv_add_inv_eq_one
  simp only [avg]
  rw [Real.div_rpow (Finset.sum_nonneg fun _ _ => Real.rpow_nonneg (hu _) _) h2.le,
    Real.div_rpow (Finset.sum_nonneg fun _ _ => Real.rpow_nonneg (hv _) _) h2.le,
    div_mul_div_comm, ← Real.rpow_add h2, e, Real.rpow_one]
  exact div_le_div_of_nonneg_right h h2.le

/-- `⟨f, g⟩ ≤ ‖g‖_{p'} ‖f‖_p`. -/
private theorem cbt_avg_apply_le {p p' : ℝ} (hp : p.HolderConjugate p')
    (g : (Fin N → Bool) → StrongDual ℝ X) (f : (Fin N → Bool) → X) :
    avg (fun ε => g ε (f ε)) ≤
      SignCube.lpNorm (fun x => ‖x‖) p' g * SignCube.lpNorm (fun x => ‖x‖) p f :=
  (avg_mono fun ε => (le_abs_self _).trans ((g ε).le_opNorm (f ε))).trans
    (cbt_avg_mul_le hp.symm (fun _ => norm_nonneg _) fun _ => norm_nonneg _)

/-- Duality for nonnegative functions: if `E φ u ≤ C ‖φ‖_{p'}` for every `φ ≥ 0`, then
`‖u‖_p ≤ C` (take `φ = u^{p−1}`). -/
private theorem cbt_rpow_avg_le {p p' : ℝ} (hp : p.HolderConjugate p') {u : (Fin N → Bool) → ℝ}
    (hu : ∀ ε, 0 ≤ u ε) {C : ℝ} (hC : 0 ≤ C)
    (h : ∀ φ : (Fin N → Bool) → ℝ, (∀ ε, 0 ≤ φ ε) →
      avg (fun ε => φ ε * u ε) ≤ C * avg (fun ε => φ ε ^ p') ^ (1 / p')) :
    avg (fun ε => u ε ^ p) ^ (1 / p) ≤ C := by
  have key := h (fun ε => u ε ^ (p - 1)) fun ε => Real.rpow_nonneg (hu ε) _
  have e1 : ∀ ε, u ε ^ (p - 1) * u ε = u ε ^ p := fun ε => by
    rw [← Real.rpow_add_one' (hu ε) (by rw [sub_add_cancel]; exact hp.ne_zero), sub_add_cancel]
  have e2 : ∀ ε, (u ε ^ (p - 1)) ^ p' = u ε ^ p := fun ε => by
    rw [← Real.rpow_mul (hu ε), hp.sub_one_mul_conj]
  simp only [e1, e2] at key
  set A := avg fun ε => u ε ^ p with hA
  have hA0 : 0 ≤ A := avg_nonneg fun ε => Real.rpow_nonneg (hu ε) _
  rcases hA0.eq_or_lt with h0 | h0
  · rw [← h0, Real.zero_rpow hp.one_div_ne_zero]
    exact hC
  · have e : A = A ^ (1 / p) * A ^ (1 / p') := by
      rw [← Real.rpow_add h0, one_div, one_div, hp.inv_add_inv_eq_one, Real.rpow_one]
    nth_rewrite 1 [e] at key
    exact le_of_mul_le_mul_right key (Real.rpow_pos_of_pos h0 _)

/-- `‖φ x‖_p ≤ ‖φ‖_p` for `φ ≥ 0` and vectors `x_ε` of norm at most `1`. -/
private theorem cbt_lpNorm_smul_le {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {p : ℝ}
    (hp : 0 < p) {φ : (Fin N → Bool) → ℝ} (hφ : ∀ ε, 0 ≤ φ ε) {x : (Fin N → Bool) → E}
    (hx : ∀ ε, ‖x ε‖ ≤ 1) :
    SignCube.lpNorm (fun x => ‖x‖) p (fun ε => φ ε • x ε) ≤
      avg (fun ε => φ ε ^ p) ^ (1 / p) := by
  refine Real.rpow_le_rpow (avg_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) _)
    (avg_mono fun ε => Real.rpow_le_rpow (norm_nonneg _) ?_ hp.le) (by positivity)
  change ‖φ ε • x ε‖ ≤ φ ε
  rw [norm_smul, Real.norm_of_nonneg (hφ ε)]
  exact mul_le_of_le_one_right (hφ ε) (hx ε)

/-- The `L^{p'} (X*)` bound of a transform from its `L^p (X)` bound (HNVW, Lemma 3.5.3, p. 222): the
adjoint of `T` is the transform by the same signs, and `L^p (X)` norms `L^{p'} (X*)`: the norm of a
function `h` with values in `X*` is computed by the functions `φ x` with `φ ≥ 0` and `x_ε` a
near-norming vector of `h ε`. -/
theorem IsTransformBound.dual {p p' K : ℝ} (hp : p.HolderConjugate p') (hσ : IsPredictable σ)
    (hK : 0 ≤ K) (h : IsTransformBound X σ p K) : IsTransformBound (StrongDual ℝ X) σ p' K := by
  intro g
  have hg0 : 0 ≤ SignCube.lpNorm (fun x => ‖x‖) p' g :=
    lpNorm_nonneg (fun x => norm_nonneg x) p' g
  refine cbt_rpow_avg_le hp.symm (fun _ => norm_nonneg _) (mul_nonneg hK hg0) fun φ hφ => ?_
  have hφ0 : 0 ≤ avg φ := avg_nonneg hφ
  refine le_of_forall_pos_le_add fun η hη => ?_
  -- near-norming vectors of the values of `T g`
  have hδ : 0 < η / (avg φ + 1) := by positivity
  have hx : ∀ ε, ∃ x : X, ‖x‖ ≤ 1 ∧
      ‖cubeTransform σ g ε‖ - η / (avg φ + 1) ≤ cubeTransform σ g ε x := by
    intro ε
    obtain ⟨x, hx1, hx⟩ := (cubeTransform σ g ε).exists_lt_apply_of_lt_opNorm
      (sub_lt_self ‖cubeTransform σ g ε‖ hδ)
    rcases le_total 0 (cubeTransform σ g ε x) with h0 | h0
    · rw [Real.norm_of_nonneg h0] at hx
      exact ⟨x, hx1.le, hx.le⟩
    · rw [Real.norm_of_nonpos h0] at hx
      exact ⟨-x, by rw [norm_neg]; exact hx1.le, by rw [map_neg]; exact hx.le⟩
  choose x hx1 hx using hx
  have hf : SignCube.lpNorm (fun x => ‖x‖) p (fun ε => φ ε • x ε) ≤
      avg (fun ε => φ ε ^ p) ^ (1 / p) := cbt_lpNorm_smul_le hp.pos hφ hx1
  calc avg (fun ε => φ ε * ‖cubeTransform σ g ε‖)
      ≤ avg (fun ε => cubeTransform σ g ε (φ ε • x ε) + η / (avg φ + 1) * φ ε) := by
        refine avg_mono fun ε => ?_
        rw [map_smul, smul_eq_mul]
        nlinarith [mul_le_mul_of_nonneg_left (hx ε) (hφ ε)]
    _ = avg (fun ε => g ε (cubeTransform σ (fun ε => φ ε • x ε) ε)) +
          η / (avg φ + 1) * avg φ := by
        rw [avg_add, avg_const_mul, avg_apply_cubeTransform hσ]
    _ ≤ SignCube.lpNorm (fun x => ‖x‖) p' g *
          (K * SignCube.lpNorm (fun x => ‖x‖) p (fun ε => φ ε • x ε)) + η := by
        refine add_le_add ((cbt_avg_apply_le hp g _).trans
          (mul_le_mul_of_nonneg_left (h _) hg0)) ?_
        rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
        nlinarith
    _ ≤ SignCube.lpNorm (fun x => ‖x‖) p' g * (K * avg (fun ε => φ ε ^ p) ^ (1 / p)) + η := by
        gcongr
    _ = K * SignCube.lpNorm (fun x => ‖x‖) p' g * avg (fun ε => φ ε ^ p) ^ (1 / p) + η := by
        ring

/-- The `L^p (X)` bound of a transform from its `L^{p'} (X*)` bound (HNVW, Lemma 3.5.3, p. 222):
`L^{p'} (X*)` norms `L^p (X)`: the norm of a function `h` with values in `X` is computed by the
functions `φ x*` with `φ ≥ 0` and `x*_ε` a norming functional of `h ε` (Hahn–Banach). -/
theorem IsTransformBound.of_dual {p p' K : ℝ} (hp : p.HolderConjugate p') (hσ : IsPredictable σ)
    (hK : 0 ≤ K) (h : IsTransformBound (StrongDual ℝ X) σ p' K) : IsTransformBound X σ p K := by
  intro f
  have hf0 : 0 ≤ SignCube.lpNorm (fun x => ‖x‖) p f := lpNorm_nonneg (fun x => norm_nonneg x) p f
  refine cbt_rpow_avg_le hp (fun _ => norm_nonneg _) (mul_nonneg hK hf0) fun φ hφ => ?_
  choose ψ hψ1 hψ using fun ε => exists_dual_vector'' ℝ (cubeTransform σ f ε)
  have hg : SignCube.lpNorm (fun x => ‖x‖) p' (fun ε => φ ε • ψ ε) ≤
      avg (fun ε => φ ε ^ p') ^ (1 / p') := cbt_lpNorm_smul_le hp.symm.pos hφ hψ1
  calc avg (fun ε => φ ε * ‖cubeTransform σ f ε‖)
      = avg (fun ε => (φ ε • ψ ε) (cubeTransform σ f ε)) := by
        simp only [smul_apply, hψ, smul_eq_mul, RCLike.ofReal_real_eq_id, id_eq]
    _ = avg (fun ε => cubeTransform σ (fun ε => φ ε • ψ ε) ε (f ε)) :=
        avg_apply_cubeTransform hσ (fun ε => φ ε • ψ ε) f
    _ ≤ K * SignCube.lpNorm (fun x => ‖x‖) p' (fun ε => φ ε • ψ ε) *
          SignCube.lpNorm (fun x => ‖x‖) p f :=
        (cbt_avg_apply_le hp _ f).trans (mul_le_mul_of_nonneg_right (h _) hf0)
    _ ≤ K * avg (fun ε => φ ε ^ p') ^ (1 / p') * SignCube.lpNorm (fun x => ‖x‖) p f := by
        gcongr
    _ = K * SignCube.lpNorm (fun x => ‖x‖) p f * avg (fun ε => φ ε ^ p') ^ (1 / p') := by
        ring

/-- **HNVW, Lemma 3.5.3** (p. 222), the norms: `‖T‖_{L^p (X)} = ‖T‖_{L^{p'} (X*)}`, stated as the
equality of the sets of bounds. -/
theorem isTransformBound_iff_dual {p p' K : ℝ} (hp : p.HolderConjugate p') (hσ : IsPredictable σ)
    (hK : 0 ≤ K) : IsTransformBound X σ p K ↔ IsTransformBound (StrongDual ℝ X) σ p' K :=
  ⟨fun h => h.dual hp hσ hK, fun h => h.of_dual hp hσ hK⟩

end Adjoint

